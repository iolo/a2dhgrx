0065C3  2  65 54          adc MATH_BL
0065C5  2  85 50          sta MATH_AL
0065C7  2  A5 51          lda MATH_AH
0065C9  2  65 55          adc MATH_BH
0065CB  2  85 51          sta MATH_AH
0065CD  2  60             rts
0065CE  2               .endproc
