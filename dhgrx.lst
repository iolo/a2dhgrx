00632D  1               ; @param ch
00632D  1               .proc	dhgr_putc
00632D  1  A9 00        	lda	#<font4x6
00632F  1  85 CE        	sta	src
006331  1  A9 6C        	lda	#>font4x6
006333  1  85 CF        	sta	src+1
006335  1               
006335  1  A5 FF        	lda	ch
006337  1  38           	sec
006338  1  E9 20        	sbc	#$20	; A = ch - $20
00633A  1  85 FF        	sta	ch
00633C  1               
00633C  1  A5 CE        	lda	src
00633E  1  18           	clc
00633F  1  65 FF        	adc	ch
006341  1  65 FF        	adc	ch
006343  1  65 FF        	adc	ch
006345  1  85 CE        	sta	src
006347  1  A5 CF        	lda	src+1
006349  1  69 00        	adc	#$00
00634B  1  85 CF        	sta	src+1	; src = font4x6 + (ch - 0x20)*3
00634D  1               
00634D  1  A5 FA        	lda	x1
00634F  1  18           	clc
006350  1  69 03        	adc	#(FONT_WIDTH-1)
006352  1  85 FC        	sta	x2
006354  1               
006354  1  A5 FB        	lda	y1
006356  1  18           	clc
006357  1  69 05        	adc	#(FONT_HEIGHT-1)
006359  1  85 FD        	sta	y2
00635B  1               
00635B  1  20 F5 62     	jsr	dhgr_bitmap
00635E  1  60           	rts
00635F  1               .endproc
