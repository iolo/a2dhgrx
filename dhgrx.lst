0065CE  2               dividend = MATH_AX
0065CE  2               divisor = MATH_BX
0065CE  2               remainder = MATH_CX
0065CE  2               result = dividend ;save memory by reusing divident to store the result
0065CE  2               
0065CE  2               @divide:
0065CE  2  A9 00          lda #0	        ;preset remainder to 0
0065D0  2  85 52        	sta remainder
0065D2  2  85 53        	sta remainder+1
0065D4  2  A2 10        	ldx #16	        ;repeat for each bit: ...
0065D6  2               
0065D6  2               @divloop:
0065D6  2  06 50          asl dividend	;dividend lb & hb*2, msb -> Carry
0065D8  2  26 51        	rol dividend+1
0065DA  2  26 52        	rol remainder	;remainder lb & hb * 2 + msb from carry
0065DC  2  26 53        	rol remainder+1
0065DE  2  A5 52        	lda remainder
0065E0  2  38           	sec
0065E1  2  E5 54        	sbc divisor	;substract divisor to see if it fits in
0065E3  2  A8           	tay	        ;lb result -> Y, for we may need it later
0065E4  2  A5 53        	lda remainder+1
0065E6  2  E5 55        	sbc divisor+1
0065E8  2  90 06        	bcc @skip	;if carry=0 then divisor didn't fit in yet
0065EA  2               
0065EA  2  85 53        	sta remainder+1	;else save substraction result as new remainder,
0065EC  2  84 52        	sty remainder
0065EE  2  E6 50        	inc result	;and INCrement result cause divisor fit in 1 times
0065F0  2               
0065F0  2               @skip:
0065F0  2  CA             dex
0065F1  2  D0 E3        	bne @divloop
0065F3  2  60           	rts
0065F4  2               .endproc
