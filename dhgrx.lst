006000  2               ; modified: A
006000  2               .macro  PUSH r1, r2, r3, r4, r5, r6, r7
006000  2                 .ifblank	r1
006000  2                   .exitmacro
006000  2                 .else
006000  2                   lda	r1
006000  2                   pha
006000  2                 .endif
006000  2               	PUSH r2, r3, r4, r5, r6, r7
006000  2               .endmacro
006000  2               
006000  2               
006000  2               ; modified: A
006000  2               .macro  PULL r1, r2, r3, r4, r5, r6, r7
006000  2                 .ifblank	r1
006000  2                   .exitmacro
006000  2                 .else
006000  2                   pla
006000  2                   sta	r1
006000  2                 .endif
006000  2               	PULL r2, r3, r4, r5, r6, r7
006000  2               .endmacro
