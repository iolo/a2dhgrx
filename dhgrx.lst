0062EF  1               ; draw bitmap
0062EF  1               ;
0062EF  1               ; @param x1(modified)
0062EF  1               ; @param y1(modified)
0062EF  1               ; @param x2
0062EF  1               ; @param y2
0062EF  1               ; @param color
