0061D6  1               ; draw horizontal line
0061D6  1               ; @param x1(modified)
0061D6  1               ; @param x2
0061D6  1               ; @param y1
0061D6  1               ; @param color
0061D6  1               .proc	dhgr_hline
0061D6  1  A5 FA        	lda	x1
0061D8  1  C5 FC        	cmp	x2
0061DA  1  90 06        	bcc	@no_swap
0061DC  1  A6 FC        	ldx	x2
0061DE  1  85 FC        	sta	x2
0061E0  1  86 FA        	stx	x1
0061E2  1               @no_swap:
0061E2  1               
0061E2  1  A5 FC        	lda	x2
0061E4  1  38           	sec
0061E5  1  E5 FA        	sbc	x1
0061E7  1  C9 06        	cmp	#6	; x2 - x1 < 7
0061E9  1  B0 0E        	bcs	@loopx_left
0061EB  1               
0061EB  1               ; shorter than 7 pixels, use dhgr_plot to draw each pixel(slow)
0061EB  1               ; ex. hline 1..6
0061EB  1               @loopx_short:
0061EB  1  A5 FC        	lda	x2
0061ED  1  C5 FA        	cmp	x1
0061EF  1  90 07        	bcc	@end_loopx_short ; while (x1 <= x2)
0061F1  1  20 BD 60     	jsr 	dhgr_plot
0061F4  1  E6 FA        	inc	x1
0061F6  1  D0 F3        	bne 	@loopx_short ; endwhile
0061F8  1               @end_loopx_short:
0061F8  1  60           	rts
0061F9  1               
0061F9  1               ; longer than 7 pixels, split into 3 parts: left(slow), middle(fast), right(slow)
0061F9  1               ; ex. 5..22 -> left(slow):5..6, middle(fast):7..20, right(slow):21..22
0061F9  1               ;
0061F9  1               @loopx_left:
0061F9  1  A6 FA        	ldx	x1
0061FB  1  BD 00 69     	lda	HGR_PIXEL_GROUP,x
0061FE  1  F0 07        	beq	@end_loopx_left; while (x1 % 7)
006200  1  20 BD 60     	jsr 	dhgr_plot
006203  1  E6 FA        	inc	x1
006205  1  D0 F2        	bne	@loopx_left ; endwhile
006207  1               
006207  1               @end_loopx_left:
006207  1  A6 FB        	ldx	y1
006209  1  BD 00 67     	lda	HGR_OFFSET_LO,x
00620C  1  18           	clc
