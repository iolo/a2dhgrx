006A00  2               .macro DHGR_FILL_4BYTES color, addr
006A00  2                 lda color
006A00  2                 and #$f
006A00  2                 tax
006A00  2               
006A00  2                 lda DHGR_FILL_BYTE_0,x
006A00  2                 AUX_BANK
006A00  2                 sta addr
006A00  2                 MAIN_BANK
006A00  2                 lda DHGR_FILL_BYTE_1,x
006A00  2                 sta addr
006A00  2               
006A00  2                 inc addr
006A00  2               
006A00  2                 lda DHGR_FILL_BYTE_2,x
006A00  2                 AUX_BANK
006A00  2                 sta addr
006A00  2                 MAIN_BANK
006A00  2                 lda DHGR_FILL_BYTE_3,x
006A00  2                 sta addr
006A00  2               .endmacro
