0067C1  2               ; n1 = n1 + n2
0067C1  2               .macro ADD16 n1, n2
0067C1  2                 clc
0067C1  2                 lda n1
0067C1  2                 adc n2
0067C1  2                 sta n1
0067C1  2                 lda n1+1
0067C1  2                 adc n2+1
0067C1  2                 sta n1+1
0067C1  2               .endmacro
0067C1  2               
0067C1  2               ; n1 = n1 - n2
0067C1  2               .macro SUB16 n1, n2
0067C1  2                 sec
0067C1  2                 lda n1
0067C1  2                 sbc n2
0067C1  2                 sta n1
0067C1  2                 lda n1+1
0067C1  2               .endmacro
