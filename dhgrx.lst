006015  1  4C A5 62     	jmp	dhgr_fillrect	; +21
006018  1  4C C3 62     	jmp	dhgr_pixmap	; +24
00601B  1  4C EF 62     	jmp	dhgr_bitmap	; +27
00601E  1  4C 59 63     	jmp	dhgr_puts	; +30
006021  1  4C CD 64     	jmp	dhgr_puts_ucs2	; +33
006024  1  4C 1B 65     	jmp	dhgr_puts_utf8	; +36
006027  1  00 6C        	.word	font4x6		; +39
006029  1  20 6D        	.word	font5x12	; +41
00602B  1  20 70        	.word	font10x12	; +43
00602D  1               .endproc
00602D  1               
00602D  1               ; switch to double hi-res mixed/page1
00602D  1               .proc	dhgr_init
00602D  1  8D 50 C0     	sta	$c050 ; graphics
006030  1  8D 53 C0     	sta	$c053 ; mixed
006033  1               	;sta	$c052 ; full
006033  1  8D 54 C0     	sta	$c054 ; page1
006036  1               	;sta	$c055 ; page2
006036  1  8D 57 C0     	sta	$c057 ; hires
006039  1  8D 5E C0     	sta	$c05e ; an3 on
00603C  1               
00603C  1               	; copy this code(MAIN $6000..$7fff) to AUX to avoid crash while bank switching
00603C  1  A9 00 85 3C  	MAIN2AUX $6000, $7fff, $6000
006040  1  A9 60 85 3D  
006044  1  A9 FF 85 3E  
006058  1               
006058  1  60           	rts
006059  1               .endproc
006059  1               
006059  1               ; switch to text page1
006059  1               .proc	dhgr_exit
006059  1  8D 51 C0     	sta	$c051 ; text
00605C  1  8D 5F C0     	sta	$c05f ; an3 off
00605F  1  8D 54 C0     	sta	$c054 ; page1
006062  1  60           	rts
006063  1               .endproc
006063  1               
006063  1               
006063  1               ; clear dobule hi-res page1
006063  1               ; @param color
006063  1               .proc	dhgr_cls
006063  1  A5 FE        	lda	color
006065  1  29 0F        	and	#%1111
006067  1  AA           	tax
