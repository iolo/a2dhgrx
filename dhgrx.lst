0067C0  2               
0067C0  2               ; get address for start of a row in HGR mode
0067C0  2               ; y: 0..191
0067C0  2               ; addr: address to store the result(maybe in zero-page)
0067C0  2               ;.macro	HGR_ADDRESS_Y y, addr
0067C0  2               ; 			lda			#<HGR_BASE
0067C0  2               ;				clc
0067C0  2               ;				adc			HGR_OFFSET_LO,y
0067C0  2               ;				sta			addr
0067C0  2               ;				lda			#>HGR_BASE
0067C0  2               ;				adc			HGR_OFFSET_HI,y
0067C0  2               ;				sta			addr+1
0067C0  2               ;.endmacro
0067C0  2               
0067C0  2               
0067C0  1               .include	"dhgr.inc"
0067C0  2               ; DHGR mode pixel layout
0067C0  2               ;
0067C0  2               ; 80 bytes per row(40 in AUX, 40 in MAIN), 7 color-pixels per 4 bytes, total 140 color-pixels per row.
0067C0  2               ;
0067C0  2               ; |bank      | AUX        |MAIN         | AUX         | MAIN       |   |
0067C0  2               ; |----------|------------|-------------+-------------|------------|---|
0067C0  2               ; |address   | $2000      |$2000        | $2001       | $2001      |...|
0067C0  2               ; |----------|------------|-------------+-------------|------------|---|
0067C0  2               ; |bit offset| 7 654 3210 | 7 65 4321 0 | 7 6 5432 10 | 7 6543 210 |...|
0067C0  2               ; |pixel     | - BBB AAAA | - DD CCCC B | - F EEEE DD | - GGGG FFF |...|
0067C0  2               ; |pixel bit | - 123 0123 | - 23 0123 0 | - 3 0123 01 | - 0123 012 |...|
0067C0  2               ; |x         |   1   0    |   3  2    1 |   5 4    3  |   6    5   |...|
0067C0  2               ;
0067C0  2               
0067C0  2               .ifndef DIV7_TBL
0067C0  2               
0067C0  2               ; pixel x(0..139) -> byte offset x(0..39) in row
0067C0  2               ; pixel 0..6 -> byte 0..1, pixel 17..13 -> byte 2..3, ... pixel 138..139 -> byte 38..39
0067C0  2               ; DHGR_OFFSET_X[x] = (x / 7) * 2
0067C0  2               ;
0067C0  2               ; see also HGR_OFFSET_LO/HGR_OFFSET_HI
0067C0  2               
0067C0  2               .align $100
0067C0  2               DHGR_OFFSET_X:
0067C0  2               	.byte 0, 0, 0, 0, 0, 0, 0 ; pixels 0..6
0067C0  2               	.byte 2, 2, 2, 2, 2, 2, 2 ; pixels 7..13
0067C0  2               	.byte 4, 4, 4, 4, 4, 4, 4 ; pixels 14..20
0067C0  2               	.byte 6, 6, 6, 6, 6, 6, 6 ; pixels 21..27
0067C0  2               	.byte 8, 8, 8, 8, 8, 8, 8 ; pixels 28..34
0067C0  2               	.byte 10, 10, 10, 10, 10, 10, 10 ; pixels 35..41
0067C0  2               	.byte 12, 12, 12, 12, 12, 12, 12 ; pixels 42..48
0067C0  2               	.byte 14, 14, 14, 14, 14, 14, 14 ; pixels 49..55
0067C0  2               	.byte 16, 16, 16, 16, 16, 16, 16 ; pixels 56..62
0067C0  2               	.byte 18, 18, 18, 18, 18, 18, 18 ; pixels 63..69
0067C0  2               	.byte 20, 20, 20, 20, 20, 20, 20 ; pixels 70..76
0067C0  2               	.byte 22, 22, 22, 22, 22, 22, 22 ; pixels 77..83
0067C0  2               	.byte 24, 24, 24, 24, 24, 24, 24 ; pixels 84..90
0067C0  2               	.byte 26, 26, 26, 26, 26, 26, 26 ; pixels 91..97
0067C0  2               	.byte 28, 28, 28, 28, 28, 28, 28 ; pixels 98..104
0067C0  2               	.byte 30, 30, 30, 30, 30, 30, 30 ; pixels 105..111
0067C0  2               	.byte 32, 32, 32, 32, 32, 32, 32 ; pixels 112..118
0067C0  2               	.byte 34, 34, 34, 34, 34, 34, 34 ; pixels 119..125
0067C0  2               	.byte 36, 36, 36, 36, 36, 36, 36 ; pixels 126..132
0067C0  2               	.byte 38, 38, 38, 38, 38, 38, 38 ; pixels 133..139
0067C0  2               	;.res 256-140
0067C0  2               .endif
0067C0  2               
0067C0  2               .ifndef MOD7_TBL
0067C0  2               
0067C0  2               ; pixel x(0..139) -> pixel group(0..6; A..G in DHGR pixel layout)
0067C0  2               ; x % 7 = 0..6 -> pixel group 0..6(A..G)
0067C0  2               ;
0067C0  2               ; pixel group will determine which 4 bits of the 4 bytes will be used to store the color-pixel.
0067C0  2               
0067C0  2               .align $100
0067C0  2               DHGR_PIXEL_GROUP:
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0067C0  2               	;.res 256-140
0067C0  2               .endif
0067C0  2               
0067C0  2               ; color 0..15 -> fill bytes 0..3
0067C0  2               ;
0067C0  2               ; to fill 4 bytes(7 consequent color-pixels) with a same color:
0067C0  2               ;
0067C0  2               ; lda color
0067C0  2               ; and #$f
0067C0  2               ; tax
0067C0  2               ;
0067C0  2               ; lda DHGR_FILL_BYTE_0,x
0067C0  2               ; AUX_BANK
0067C0  2               ; sta addr
0067C0  2               ; MAIN_BANK
0067C0  2               ; lda DHGR_FILL_BYTE_1,x
0067C0  2               ; sta addr
0067C0  2               ;
0067C0  2               ; inc addr
0067C0  2               ;
0067C0  2               ; lda DHGR_FILL_BYTE_2,x
0067C0  2               ; AUX_BANK
0067C0  2               ; sta addr
0067C0  2               ; MAIN_BANK
0067C0  2               ; lda DHGR_FILL_BYTE_3,x
0067C0  2               ; sta addr
0067C0  2               
0067C0  2               DHGR_FILL_BYTE_0:
0067C0  2  00 11 22 33  	.byte %00000000, %00010001, %00100010, %00110011, %01000100, %01010101, %01100110, %01110111
0067C4  2  44 55 66 77  
0067C8  2  08 19 2A 3B    .byte %00001000, %00011001, %00101010, %00111011, %01001100, %01011101, %01101110, %01111111
0067CC  2  4C 5D 6E 7F  
