00698C  2               
00698C  2               ; DHGR mode pixel layout
00698C  2               ;
00698C  2               ; 80 bytes per row(40 in AUX, 40 in MAIN), 7 color-pixels per 4 bytes, total 140 color-pixels per row.
00698C  2               ;
00698C  2               ; |bank      | AUX        |MAIN         | AUX         | MAIN       |   |
00698C  2               ; |----------|------------|-------------+-------------|------------|---|
00698C  2               ; |address   | $2000      |$2000        | $2001       | $2001      |...|
00698C  2               ; |----------|------------|-------------+-------------|------------|---|
00698C  2               ; |bit offset| 7 654 3210 | 7 65 4321 0 | 7 6 5432 10 | 7 6543 210 |...|
00698C  2               ; |pixel     | - BBB AAAA | - DD CCCC B | - F EEEE DD | - GGGG FFF |...|
00698C  2               ; |pixel bit | - 123 0123 | - 23 0123 0 | - 3 0123 01 | - 0123 012 |...|
00698C  2               ; |x         |   1   0    |   3  2    1 |   5 4    3  |   6    5   |...|
00698C  2               ;
00698C  2               
00698C  2               DHGR_PAGE1_BASE	= HGR_PAGE1_BASE
00698C  2               DHGR_PAGE2_BASE	= HGR_PAGE2_BASE
00698C  2               DHGR_BASE				= DHGR_PAGE1_BASE
00698C  2               
00698C  2               DHGR_WIDTH			= HGR_WIDTH							; 140 color-pixels, 7 color-pixels in 4 bytes = 20 groups of 4 bytes = 80 bytes per row
00698C  2               DHGR_HEIGHT			= HGR_HEIGHT
00698C  2               DHGR_WIDTH_BYTES= HGR_WIDTH_BYTES * 2		; 40 bytes in AUX + 40 bytes in MAIN
00698C  2               
00698C  2               DHGR_OFFSET_X		= HGR_OFFSET_X
00698C  2               DHGR_PIXEL_GROUP= HGR_PIXEL_GROUP
00698C  2               
00698C  2               ; color 0..15 -> fill bytes 0..3
00698C  2               ;
00698C  2               ; to fill 4 bytes(7 consequent color-pixels) with a same color:
00698C  2               ;
00698C  2               ; lda color
00698C  2               ; and #$f
00698C  2               ; tax
00698C  2               ;
00698C  2               ; lda DHGR_FILL_BYTE_0,x
00698C  2               ; AUX_BANK
00698C  2               ; sta addr
00698C  2               ; MAIN_BANK
00698C  2               ; lda DHGR_FILL_BYTE_1,x
00698C  2               ; sta addr
00698C  2               ;
00698C  2               ; inc addr
00698C  2               ;
00698C  2               ; lda DHGR_FILL_BYTE_2,x
00698C  2               ; AUX_BANK
00698C  2               ; sta addr
00698C  2               ; MAIN_BANK
00698C  2               ; lda DHGR_FILL_BYTE_3,x
00698C  2               ; sta addr
00698C  2               
00698C  2               DHGR_FILL_BYTE_0:
00698C  2  00 11 22 33  	.byte %00000000, %00010001, %00100010, %00110011, %01000100, %01010101, %01100110, %01110111
006990  2  44 55 66 77  
006994  2  08 19 2A 3B    .byte %00001000, %00011001, %00101010, %00111011, %01001100, %01011101, %01101110, %01111111
006998  2  4C 5D 6E 7F  
00699C  2               
00699C  2               DHGR_FILL_BYTE_1:
00699C  2  00 22 44 66  	.byte %00000000, %00100010, %01000100, %01100110, %00001000, %00101010, %01001100, %01101110
0069A0  2  08 2A 4C 6E  
0069A4  2  11 33 55 77    .byte %00010001, %00110011, %01010101, %01110111, %00011001, %00111011, %01011101, %01111111
0069A8  2  19 3B 5D 7F  
0069AC  2               
0069AC  2               DHGR_FILL_BYTE_2:
0069AC  2  00 44 08 4C  	.byte %00000000, %01000100, %00001000, %01001100, %00010001, %01010101, %00011001, %01011101
0069B0  2  11 55 19 5D  
0069B4  2  22 66 2A 6E    .byte %00100010, %01100110, %00101010, %01101110, %00110011, %01110111, %00111011, %01111111
0069B8  2  33 77 3B 7F  
0069BC  2               
0069BC  2               DHGR_FILL_BYTE_3:
0069BC  2  00 08 11 19  	.byte %00000000, %00001000, %00010001, %00011001, %00100010, %00101010, %00110011, %00111011
0069C0  2  22 2A 33 3B  
0069C4  2  44 4C 55 5D    .byte %01000100, %01001100, %01010101, %01011101, %01100110, %01101110, %01110111, %01111111
0069C8  2  66 6E 77 7F  
0069CC  2               
0069CC  2               .macro DHGR_FILL_4BYTES color, addr
0069CC  2                 lda color
0069CC  2                 and #$f
0069CC  2                 tax
0069CC  2               
0069CC  2                 lda DHGR_FILL_BYTE_0,x
0069CC  2                 AUX_BANK
0069CC  2                 sta addr
0069CC  2                 MAIN_BANK
0069CC  2                 lda DHGR_FILL_BYTE_1,x
0069CC  2                 sta addr
0069CC  2               
0069CC  2                 inc addr
0069CC  2               
0069CC  2                 lda DHGR_FILL_BYTE_2,x
0069CC  2                 AUX_BANK
0069CC  2                 sta addr
0069CC  2                 MAIN_BANK
0069CC  2                 lda DHGR_FILL_BYTE_3,x
0069CC  2                 sta addr
0069CC  2               .endmacro
