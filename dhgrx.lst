0062F5  1               ; draw bitmap
0062F5  1               ;
0062F5  1               ; @param x1(modified)
0062F5  1               ; @param y1(modified)
0062F5  1               ; @param x2
0062F5  1               ; @param y2
0062F5  1               ; @param color
0062F5  1               ; @param src - pointer to pixel data; 1 bit per pixel; (x2-x1+1)*(y2-y1+1) bytes
0062F5  1               .proc	dhgr_bitmap
0062F5  1  A5 FA        	lda	x1
0062F7  1  8D 2C 63     	sta	@_x1
0062FA  1               	;//lda	color
0062FA  1               	;//sta	@_color
0062FA  1               
0062FA  1               @loop:
0062FA  1  A0 00        	ldy	#0
0062FC  1  B1 CE        	lda	(src),y
0062FE  1  A2 08        	ldx	#8	; 8 bits in a byte
006300  1               @loop_bit:
006300  1  0A           	asl
006301  1  90 07        	bcc	@skip	; skip skip transparent
006303  1               	;//ldy	@_color
006303  1               	;//sty	color
006303  1  48           	pha
006304  1  DA           	phx
006305  1  20 BD 60     	jsr 	dhgr_plot
006308  1  FA           	plx
006309  1  68           	pla
00630A  1               @skip:
00630A  1  E6 FA        	inc	x1	; next column
00630C  1  A4 FC        	ldy	x2
00630E  1  C4 FA        	cpy	x1
006310  1  B0 0E        	bcs	@continue; while x1 <= x2
006312  1               
006312  1  AC 2C 63     	ldy	@_x1
006315  1  84 FA        	sty	x1	; carriage return
006317  1  E6 FB        	inc	y1	; line feed
006319  1  A4 FD        	ldy	y2
00631B  1  C4 FB        	cpy	y1
00631D  1  B0 01        	bcs	@continue; while ++y1 <= y2
00631F  1               
00631F  1  60           	rts
006320  1               
006320  1               @continue:
006320  1  CA           	dex		; next bit
006321  1  D0 DD        	bne	@loop_bit
006323  1  E6 CE        	inc	src	; next byte
006325  1  D0 D3        	bne	@loop
006327  1  E6 CF        	inc	src+1	; next page
006329  1  D0 CF        	bne	@loop	; jmp always
00632B  1  60           	rts		; safe guard
00632C  1               
00632C  1  00           @_x1:	.byte	0
00632D  1               ;//@_color:.byte	0
00632D  1               .endproc
