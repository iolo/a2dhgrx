006223  1               @loopx_middle:
006223  1  A5 FA        	lda	x1
006225  1  18           	clc
006226  1  69 07        	adc	#7
006228  1  C5 FC        	cmp	x2
00622A  1  B0 26        	bcs	@loopx_right ; while (x1 + 7 <= x2)
00622C  1  85 FA        	sta	x1	; x1 += 7
00622E  1               
00622E  1  BD 8C 69     	lda	DHGR_FILL_BYTE_0,x
006231  1  8D 55 C0     	AUX_BANK
006234  1  91 EB        	sta	(dst),y
006236  1  8D 54 C0     	MAIN_BANK
006239  1  BD 9C 69     	lda	DHGR_FILL_BYTE_1,x
00623C  1  91 EB        	sta	(dst),y
00623E  1               
00623E  1  C8           	iny
00623F  1               
00623F  1  BD AC 69     	lda	DHGR_FILL_BYTE_2,x
006242  1  8D 55 C0     	AUX_BANK
006245  1  91 EB        	sta	(dst),y
006247  1  8D 54 C0     	MAIN_BANK
00624A  1  BD BC 69     	lda	DHGR_FILL_BYTE_3,x
00624D  1  91 EB        	sta	(dst),y
00624F  1               
00624F  1  C8           	iny
006250  1  D0 D1        	bne	@loopx_middle ; endwhile
006252  1               
006252  1               @loopx_right:
006252  1  A5 FC        	lda	x2
006254  1  C5 FA        	cmp	x1
006256  1  90 07        	bcc	@end_loopx_right ; while (x1 <= x2)
006258  1  20 BD 60     	jsr 	dhgr_plot
00625B  1  E6 FA        	inc	x1
00625D  1  D0 F3        	bne	@loopx_right ; endwhile
00625F  1               
00625F  1               @end_loopx_right:
00625F  1  60           	rts
006260  1               .endproc
