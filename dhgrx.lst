0069CC  1               ;.include	"bitmap.inc"
0069CC  1               .include	"kor.s"
0069CC  2               ; convert utf8 string to ucs2 string
0069CC  2               ;
0069CC  2               ; @param src utf8 string pointer. null terminated. max length = 255 bytes
0069CC  2               ; @param dst ucs2 string pointer. null terminated. max length = 255 bytes(127 wchars)
0069CC  2               .proc utf8_to_ucs2
0069CC  2               byte1 = x1
0069CC  2               byte2 = y1
0069CC  2               byte3 = x2
0069CC  2               byte4 = y2
0069CC  2               code = color
0069CC  2               
0069CC  2  A0 00        	ldy #0	; src index
0069CE  2  A2 00        	ldx #0	; dst index
0069D0  2               
0069D0  2               @loop:
0069D0  2  B1 CE        	lda	(src),y		; A = *src
0069D2  2  F0 28        	beq	@break
0069D4  2               
0069D4  2  C9 C0        	cmp	#%11000000
0069D6  2  90 2C        	bcc	@utf8_1byte	; A < 1100000
0069D8  2               
0069D8  2  C9 E0        	cmp	#%11100000
0069DA  2  90 32        	bcc	@utf8_2byte	; A < 11100000
0069DC  2               
0069DC  2  C9 F0        	cmp	#%11110000
0069DE  2  90 50        	bcc	@utf8_3byte	; A < 11110000
0069E0  2               
0069E0  2               	;;cmp #%11111000
0069E0  2               	;;bcc @utf8_4byte	; A < 11111000
0069E0  2               
0069E0  2               @unsupported:
0069E0  2  C8           	iny
0069E1  2  A9 3F        	lda	#$3f	; '?'
0069E3  2  85 FE        	sta	code
0069E5  2  A9 00        	lda	#0
0069E7  2  85 FF        	sta	code+1
0069E9  2               
0069E9  2               @continue:
0069E9  2  5A           	phy		; save y(src index)
0069EA  2  DA 7A        	TXY		; x(dst index) -> y
0069EC  2  A5 FE        	lda	code
0069EE  2  91 EB        	sta	(dst),y	; *dst++ = code
0069F0  2  C8           	iny
0069F1  2  A5 FF        	lda	code+1
0069F3  2  91 EB        	sta	(dst),y	; *dst++ = code+1
0069F5  2  C8           	iny
0069F6  2  5A FA        	TYX		; y -> x(dst index)
0069F8  2  7A           	ply		; restore y(src index)
0069F9  2  4C D0 69     	jmp	@loop
0069FC  2               
0069FC  2               @break:
0069FC  2  DA 7A        	TXY		; x(dst index) -> y
0069FE  2  91 EB        	sta	(dst),y	; *dst++ = 0
006A00  2  C8           	iny
006A01  2  91 EB        	sta	(dst),y	; *dst = 0
006A03  2  60           	rts
006A04  2               
006A04  2               @utf8_1byte:
006A04  2               ; 0xxxxxxx -> 0x00..0x7f
006A04  2               	;;lda	(src),y
006A04  2               	;;and	#%01111111
006A04  2  85 FE        	sta	code
006A06  2  C8           	iny
006A07  2               
006A07  2  A9 00        	lda	#0
006A09  2  85 FF        	sta	code+1
006A0B  2               
006A0B  2  4C E9 69     	jmp	@continue
006A0E  2               
006A0E  2               @utf8_2byte:
006A0E  2               ; 110HHHLL 10LLLLLL -> 0x80..0x07ff (11bits)
006A0E  2               	;;lda	(src),y
006A0E  2  29 1F        	and	#%00011111
006A10  2  85 FA        	sta	byte1	; byte1 = *src++ & 000HHHLL
006A12  2  C8           	iny
006A13  2               
006A13  2  B1 CE        	lda	(src),y
006A15  2  29 3F        	and	#%00111111
006A17  2  85 FB        	sta	byte2	; byte2 = *src++ & 00LLLLLL
006A19  2  C8           	iny
006A1A  2               
006A1A  2  A5 FA        	lda	byte1
006A1C  2  0A           	asl
006A1D  2  0A           	asl
006A1E  2  0A           	asl
006A1F  2  0A           	asl
006A20  2  0A           	asl
006A21  2  0A           	asl
006A22  2  05 FB        	ora	byte2
006A24  2  85 FE        	sta	code
006A26  2               
006A26  2  A5 FA        	lda	byte1
006A28  2  4A           	lsr
006A29  2  4A           	lsr
006A2A  2  4A           	lsr
006A2B  2  85 FF        	sta	code+1
006A2D  2               
006A2D  2  4C E9 69     	jmp	@continue
006A30  2               
006A30  2               @utf8_3byte:
006A30  2               ; 1110xxxx 10xxxxxx 10xxxxxx -> 0x800..0xffff (16bits)
006A30  2               	;;lda	(src),y
006A30  2  29 0F        	and	#%00001111
006A32  2  85 FA        	sta	byte1	; byte1 = *src++ & 0000HHHH
006A34  2  C8           	iny
006A35  2               
006A35  2  B1 CE        	lda	(src),y
006A37  2  29 3F        	and	#%00111111
006A39  2  85 FB        	sta	byte2	; byte2 = *src++ & 00HHHHLL
006A3B  2  C8           	iny
006A3C  2               
006A3C  2  B1 CE        	lda	(src),y
006A3E  2  29 3F        	and	#%00111111
006A40  2  85 FC        	sta	byte3	; byte3 = *src++ & 00LLLLLL
006A42  2  C8           	iny
006A43  2               
006A43  2  A5 FB        	lda	byte2
006A45  2  0A           	asl
006A46  2  0A           	asl
006A47  2  0A           	asl
006A48  2  0A           	asl
006A49  2  0A           	asl
006A4A  2  0A           	asl
006A4B  2  05 FC        	ora	byte3
006A4D  2  85 FE        	sta	code
006A4F  2               
006A4F  2  A5 FA        	lda	byte1
006A51  2  0A           	asl
006A52  2  0A           	asl
006A53  2  0A           	asl
006A54  2  0A           	asl
006A55  2  85 FA        	sta	byte1
006A57  2  A5 FB        	lda	byte2
006A59  2  4A           	lsr
006A5A  2  4A           	lsr
006A5B  2  05 FA        	ora	byte1
006A5D  2  85 FF        	sta	code+1
006A5F  2               
006A5F  2  4C E9 69     	jmp	@continue
006A62  2               
006A62  2               @utf8_4byte:
006A62  2               ; 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx -> 0x10000..0x10ffff (21bits)
006A62  2  C8           	iny
006A63  2  C8           	iny
006A64  2  C8           	iny
006A65  2  4C E0 69     	jmp	@unsupported
006A68  2               .endproc
006A68  2               
006A68  2               ; decompose ucs2 into cho, jung, jong
006A68  2               ; @param code(modified)
006A68  2               ; @return cho, jung, jong
006A68  2               .proc decompose_ucs2
006A68  2               ;;	; ensure (syllable < 0xAC00 || syllable > 0xD7A3)
006A68  2               ;;	lda	code+1
006A68  2               ;;	cmp	#>KOR_CODE_BEGIN
006A68  2               ;;	bcc	@not_hangul	; error if hi(code) < $AC
006A68  2               ;;	cmp	#>KOR_CODE_END
006A68  2               ;;	beq	@check_lo
006A68  2               ;;	bcs	@not_hangul	; error if hi(code) >= $D7
006A68  2               ;;@check_lo:
006A68  2               ;;	lda	code
006A68  2               ;;	cmp	#<(KOR_CODE_END+1)
006A68  2               ;;	bcs	@not_hangul	; error if hi(code) == $D7 and lo(code) >= $A4
006A68  2               
006A68  2  A5 FC        	lda	code
006A6A  2  38           	sec
006A6B  2  E9 00        	sbc	#<KOR_CODE_BEGIN
006A6D  2  85 FC        	sta	code
006A6F  2  A5 FD        	lda	code+1
006A71  2  E9 AC        	sbc	#>KOR_CODE_BEGIN
006A73  2  85 FD        	sta	code+1		;  code -= 0xAC00;
006A75  2               
006A75  2  A5 50 48 A5  	MATH_PUSH16 MATH_AX,MATH_BX,MATH_CX
006A79  2  51 48 A5 54  
006A7D  2  48 A5 55 48  
006A87  2               
006A87  2               	; jong = code % JONG_COUNTT
006A87  2               	; jung = (code / JONG_COUNT) % JUNG_COUNT
006A87  2               	; cho = (code / JONG_COUNT) / JUNG_COUNT
006A87  2               
006A87  2               	; MATH_AX = code / 28, MATH_CX = code % 28
006A87  2  A5 FC 85 50  	MATH_LOAD16 MATH_AX,code
006A8B  2  A5 FD 85 51  
006A8F  2  A9 1C 85 54  	MATH_LOAD16 MATH_BX,#JONG_COUNT
006A93  2  A9 00 85 55  
006A97  2  20 CE 65     	jsr	MATH_DIV16
006A9A  2  A5 52 85 FC  	MATH_STORE8 MATH_CL,jong
006A9E  2               
006A9E  2               	; MATH_AX = (code / 28) / 21, MATH_CX = (code / 28) % 21
006A9E  2  A9 15 85 54  	MATH_LOAD16 MATH_BX,#JUNG_COUNT
006AA2  2  A9 00 85 55  
006AA6  2  20 CE 65     	jsr	MATH_DIV16
006AA9  2  A5 52 85 FB  	MATH_STORE8 MATH_CL,jung
006AAD  2  A5 50 85 FA  	MATH_STORE8 MATH_AL,cho
006AB1  2               
006AB1  2  68 85 53 68  	MATH_PULL16 MATH_CX,MATH_BX,MATH_AX
006AB5  2  85 52 68 85  
006AB9  2  55 68 85 54  
006AC3  2  60           	rts
006AC4  2               
006AC4  2               @not_hangul:
006AC4  2  A9 00        	lda #0
006AC6  2  85 FA        	sta cho
006AC8  2  85 FB        	sta jung
006ACA  2  85 FC        	sta jong
006ACC  2  60           	rts
006ACD  2               .endproc
006ACD  2               
006ACD  2               ; compose cho, jung, jong into ucs2
006ACD  2               ; @param cho
006ACD  2               ; @param jung
006ACD  2               ; @param jong
006ACD  2               ; @returns src
006ACD  2               .proc compose_ucs2
006ACD  2  A9 12        	lda #(CHO_COUNT-1)
006ACF  2  C5 FA        	cmp cho
006AD1  2  90 0C        	bcc @error	; 18 < cho
006AD3  2  A9 14        	lda #(JUNG_COUNT-1)
006AD5  2  C5 FB        	cmp jung
006AD7  2  90 06        	bcc @error	; 20 < jung
006AD9  2  A9 1B        	lda #(JONG_COUNT-1)
006ADB  2  C5 FC        	cmp jong
006ADD  2  90 00        	bcc @error	; 27 < jong
006ADF  2               @error:
006ADF  2  A9 7F        	lda #$7f
006AE1  2  85 FC        	sta code
006AE3  2  A9 00        	lda #0
006AE5  2  85 FD        	sta code+1
006AE7  2  60           	rts
006AE8  2               
006AE8  2               	; code = cho * 588 + jung * 28 + jong
006AE8  2               
006AE8  2               	; 588 = 512 + 64 + 8 + 4
006AE8  2               	; code += cho << 2; // cho * 4
006AE8  2  A5 FA        	lda cho
006AEA  2  0A           	asl
006AEB  2  0A           	asl
006AEC  2  18           	clc
006AED  2  AA           	tax
006AEE  2  65 FC        	adc code
006AF0  2  A9 00        	lda #0
006AF2  2  65 FD        	adc code+1
006AF4  2               	; code += cho << 3; // cho * 8
006AF4  2  8A           	txa
006AF5  2  0A           	asl
006AF6  2  18           	clc
006AF7  2  AA           	tax
006AF8  2  65 FC        	adc code
006AFA  2  A9 00        	lda #0
006AFC  2  65 FD        	adc code+1
006AFE  2               	; code += cho << 6; // cho * 64
006AFE  2  8A           	txa
006AFF  2  0A           	asl
006B00  2  0A           	asl
006B01  2  0A           	asl
006B02  2  AA           	tax
006B03  2  18           	clc
006B04  2  65 FC        	adc code
006B06  2  A9 00        	lda #0
006B08  2  65 FD        	adc code+1
006B0A  2               	; code += cho << 9; // cho * 512
006B0A  2  8A           	txa
006B0B  2  0A           	asl
006B0C  2  0A           	asl
006B0D  2  0A           	asl
006B0E  2  18           	clc
006B0F  2  65 FC        	adc code
006B11  2  A9 00        	lda #0
006B13  2  65 FD        	adc code+1
006B15  2               
006B15  2               	; 28 = 16 + 8 + 4
006B15  2               	; code += jung << 2; // jung * 4
006B15  2  A5 FB        	lda jung
006B17  2  0A           	asl
006B18  2  0A           	asl
006B19  2  18           	clc
006B1A  2  AA           	tax
006B1B  2  65 FC        	adc code
006B1D  2  A9 00        	lda #0
006B1F  2  65 FD        	adc code+1
006B21  2               	; code += jung << 3; // jung * 8
006B21  2  8A           	txa
006B22  2  0A           	asl
006B23  2  AA           	tax
006B24  2  18           	clc
006B25  2  65 FC        	adc code
006B27  2  A9 00        	lda #0
006B29  2  65 FD        	adc code+1
006B2B  2               	; code += jung << 4; // jung * 16
006B2B  2  8A           	txa
006B2C  2  0A           	asl
006B2D  2  AA           	tax
006B2E  2  18           	clc
006B2F  2  65 FC        	adc code
006B31  2  A9 00        	lda #0
006B33  2  65 FD        	adc code+1
006B35  2               
006B35  2               	; code += jong;
006B35  2  A5 FC        	lda jong
006B37  2  18           	clc
006B38  2  65 FC        	adc code
006B3A  2  A9 00        	lda #0
006B3C  2  65 FD        	adc code+1
006B3E  2               
006B3E  2               	; code += 0xAC00
006B3E  2               	;lda code
006B3E  2               	;clc
006B3E  2               	;adc #$00
006B3E  2  A5 FD        	lda code+1
006B40  2  69 AC        	adc #$AC
006B42  2  85 FD        	sta code+1
006B44  2               
006B44  2  60           	rts
006B45  2               .endproc
006B45  2               
