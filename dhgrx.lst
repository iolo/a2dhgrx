0062C9  1               .proc	dhgr_pixmap
0062C9  1  A5 FA        	lda	x1
0062CB  1  8D F4 62     	sta	@_x1
0062CE  1               
0062CE  1  A0 00        	ldy	#0
0062D0  1               @loop:
0062D0  1  B1 CE        	lda	(src),y
0062D2  1  85 FE        	sta	color
0062D4  1  29 F0        	and	#$f0
0062D6  1  D0 05        	bne	@skip	; skip transparent(when hi-nibble is not zero)
0062D8  1  5A           	phy
0062D9  1  20 BD 60     	jsr 	dhgr_plot
0062DC  1  7A           	ply
0062DD  1               @skip:
0062DD  1  C8           	iny	; next pixel
0062DE  1               
0062DE  1  E6 FA        	inc	x1
0062E0  1  A6 FC        	ldx	x2
0062E2  1  E4 FA        	cpx	x1
0062E4  1  B0 EA        	bcs	@loop	; x2 >= ++x1
0062E6  1               
0062E6  1  AE F4 62     	ldx	@_x1
0062E9  1  86 FA        	stx	x1	; reset x1(next row, first column)
0062EB  1  E6 FB        	inc	y1
0062ED  1  A6 FD        	ldx	y2
0062EF  1  E4 FB        	cpx	y1
0062F1  1  B0 DD        	bcs	@loop	; y2 >= ++y1
