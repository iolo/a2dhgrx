0065C0  2               ; load 8bit register from immediate or absolute
0065C0  2               .macro MATH_LOAD8 reg,arg
0065C0  2                 .if (.match(.left (1, {arg}), #))
0065C0  2                   ; immediate
0065C0  2                   lda #<(.right (.tcount ({arg})-1, {arg})
0065C0  2                   sta reg
0065C0  2                 .else
0065C0  2                   ; absolute
0065C0  2                   lda arg
0065C0  2                   sta reg
0065C0  2                 .endif
0065C0  2               .endmacro
0065C0  2               
0065C0  2               ; load 16bit register from immediate or absolute
0065C0  2               .macro MATH_LOAD16 reg,arg
0065C0  2                 .if (.match(.left (1, {arg}), #))
0065C0  2                   ; immediate
0065C0  2                   lda #<(.right (.tcount ({arg})-1, {arg}))
0065C0  2                   sta reg
0065C0  2                   lda #>(.right (.tcount ({arg})-1, {arg}))
0065C0  2                   sta reg+1
0065C0  2                 .else
0065C0  2                   ; absolute
0065C0  2                   lda arg
0065C0  2                   sta reg
0065C0  2                   lda arg+1
0065C0  2                   sta reg+1
0065C0  2                 .endif
0065C0  2               .endmacro
0065C0  2               
0065C0  2               ; store 8bit register to absolute
0065C0  2               .macro MATH_STORE8 reg,arg
0065C0  2                 lda reg
0065C0  2                 sta arg
0065C0  2               .endmacro
0065C0  2               
0065C0  2               ; store 16bit register to absolute
0065C0  2               .macro MATH_STORE16 reg,arg
0065C0  2                 lda reg
0065C0  2                 sta arg
0065C0  2                 lda reg+1
0065C0  2                 sta arg+1
0065C0  2               .endmacro
