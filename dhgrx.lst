006080  1  85 FD        	sta	y2
006082  1               
006082  1  A2 00        	ldx	#0 ; y=0
006084  1               @loop_y:
006084  1  A9 00        	lda	#<HGR_BASE
006086  1  18           	clc
006087  1  7D 00 67     	adc	HGR_OFFSET_LO,x
00608A  1  85 EB        	sta	dst
00608C  1  A9 20        	lda	#>HGR_BASE
00608E  1  7D 00 66     	adc	HGR_OFFSET_HI,x
006091  1  85 EC        	sta	dst+1	; dst = HGR_BASE + HGR_OFFSET[y]
006093  1               
006093  1  A0 00        	ldy	#0 ; x=0
006095  1               @loop_x:
006095  1               ; AUX dst[x] = byte0
006095  1  A5 FA        	lda	x1
006097  1  8D 55 C0     	AUX_BANK
00609A  1  91 EB        	sta     (dst),y
00609C  1  8D 54 C0     	MAIN_BANK
00609F  1               
00609F  1               ; MAIN dst[x] = byte1
00609F  1  A5 FB        	lda	y1
0060A1  1               	;MAIN_BANK
0060A1  1  91 EB        	sta     (dst),y
0060A3  1               
0060A3  1  C8           	iny	; x++
0060A4  1               
0060A4  1               ; AUX dst[x] = byte2
0060A4  1  A5 FC        	lda	x2
0060A6  1  8D 55 C0     	AUX_BANK
0060A9  1  91 EB        	sta     (dst),y
0060AB  1  8D 54 C0     	MAIN_BANK
0060AE  1               
0060AE  1               ; MAIN dst[x] = byte3
0060AE  1  A5 FD        	lda	y2
0060B0  1               	;MAIN_BANK
0060B0  1  91 EB        	sta     (dst),y
0060B2  1               
0060B2  1  C8           	iny	; x++
0060B3  1  C0 28        	cpy	#(DHGR_WIDTH_BYTES/2)	; 40 in aux + 40 in main
0060B5  1  D0 DE        	bne	@loop_x ; while(x!=40)
0060B7  1               
0060B7  1  E8           	inx	; y++
0060B8  1  E0 C0        	cpx	#DHGR_HEIGHT
0060BA  1  D0 C8        	bne	@loop_y ; while(y!=192)
0060BC  1               
0060BC  1  60           	rts
0060BD  1               .endproc
