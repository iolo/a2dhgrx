00607A  1  85 FD        	sta	y2
00607C  1               
00607C  1  A2 00        	ldx	#0 ; y=0
00607E  1               @loop_y:
00607E  1  A9 00        	lda	#<HGR_BASE
006080  1  18           	clc
006081  1  7D 00 69     	adc	HGR_OFFSET_LO,x
006084  1  85 EB        	sta	dst
006086  1  A9 20        	lda	#>HGR_BASE
006088  1  7D 00 68     	adc	HGR_OFFSET_HI,x
00608B  1  85 EC        	sta	dst+1	; dst = HGR_BASE + HGR_OFFSET[y]
00608D  1               
00608D  1  A0 00        	ldy	#0 ; x=0
00608F  1               @loop_x:
00608F  1               ; AUX dst[x] = byte0
00608F  1  A5 FA        	lda	x1
006091  1  8D 55 C0     	AUX_BANK
006094  1  91 EB        	sta     (dst),y
006096  1  8D 54 C0     	MAIN_BANK
006099  1               
006099  1               ; MAIN dst[x] = byte1
006099  1  A5 FB        	lda	y1
00609B  1               	;MAIN_BANK
00609B  1  91 EB        	sta     (dst),y
00609D  1               
00609D  1  C8           	iny	; x++
00609E  1               
00609E  1               ; AUX dst[x] = byte2
00609E  1  A5 FC        	lda	x2
0060A0  1  8D 55 C0     	AUX_BANK
0060A3  1  91 EB        	sta     (dst),y
0060A5  1  8D 54 C0     	MAIN_BANK
0060A8  1               
0060A8  1               ; MAIN dst[x] = byte3
0060A8  1  A5 FD        	lda	y2
0060AA  1               	;MAIN_BANK
0060AA  1  91 EB        	sta     (dst),y
0060AC  1               
0060AC  1  C8           	iny	; x++
0060AD  1  C0 28        	cpy	#(DHGR_BYTES_PER_ROW/2)	; 40 in aux + 40 in main
0060AF  1  D0 DE        	bne	@loop_x ; while(x!=40)
0060B1  1               
0060B1  1  E8           	inx	; y++
0060B2  1  E0 C0        	cpx	#DHGR_HEIGHT
0060B4  1  D0 C8        	bne	@loop_y ; while(y!=192)
0060B6  1               
0060B6  1  60           	rts
0060B7  1               .endproc
