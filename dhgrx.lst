0062B1  1  85 FD        	sta	y2
0062B3  1  86 FB        	stx	y1
0062B5  1               @no_swap:
0062B5  1               
0062B5  1               @loopy:
0062B5  1  A5 FA 48     	PUSH	x1
0062B8  1  20 D6 61     	jsr 	dhgr_hline
0062BB  1  68 85 FA     	PULL	x1
