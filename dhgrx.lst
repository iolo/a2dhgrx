0063AA  1               
0063AA  1               ENG_FONT_ADDR = font5x12
0063AA  1               ENG_FONT_WIDTH = 5
0063AA  1               ENG_FONT_HEIGHT = 12
0063AA  1               ENG_CODE_BEGIN = $20
0063AA  1               ENG_CODE_END = $7f
0063AA  1               ENG_GLYPH_COUNT = 96	; 0x20 ~ 0x7f
0063AA  1               ENG_GLYPH_SIZE = 8	; 5x12 = 60bits -> 60/8 <= 8bytes
0063AA  1               
0063AA  1               KOR_FONT_WIDTH = 10
0063AA  1               KOR_FONT_HEIGHT = 12
0063AA  1               KOR_CODE_BEGIN = $ac00	; 가
0063AA  1               KOR_CODE_END = $d7a3	; 힣
0063AA  1               NUM_CHO_FORM = 3	; 0 for vertical-shaped, 1 for horizontal-shaped, 2 for compound
0063AA  1               NUM_JUNG_FORM = 1
0063AA  1               NUM_JONG_FORM = 1
0063AA  1               CHO_COUNT = 19		; ㄱ,ㄲ,ㄴ,ㄷ,ㄸ,ㄹ,ㅁ,ㅂ,ㅃ,ㅅ,ㅆ,ㅇ,ㅈ,ㅉ,ㅊ,ㅋ,ㅌ,ㅍ,ㅎ
0063AA  1               JUNG_COUNT = 21		; ㅏ,ㅐ,ㅑ,ㅒ,ㅓ,ㅔ,ㅕ,ㅖ,ㅗ,ㅘ,ㅙ,ㅚ,ㅛ,ㅜ,ㅝ,ㅞ,ㅟ,ㅠ,ㅡ,ㅢ,ㅣ
0063AA  1               JONG_COUNT = 28		; fill,ㄱ,ㄲ,ㄳ,ㄴ,ㄵ,ㄶ,ㄷ,ㄹ,ㄺ,ㄻ,ㄼ,ㄽ,ㄾ,ㄿ,ㅀ,ㅁ,ㅂ,ㅄ,ㅅ,ㅆ,ㅇ,ㅈ,ㅊ,ㅋ,ㅌ,ㅍ,ㅎ
0063AA  1               KOR_GLYPH_SIZE = 15	; 10x12 = 120bits -> 120/8 = 15bytes
0063AA  1               KOR_GLYPH_COUNT = NUM_CHO_FORM*CHO_COUNT + NUM_JUNG_FORM*JUNG_COUNT + NUM_JONG_FORM*(JONG_COUNT-1)
0063AA  1               
0063AA  1               KOR_FONT_ADDR = font10x12
0063AA  1               CHO_FONT_ADDR = KOR_FONT_ADDR
0063AA  1               JUNG_FONT_ADDR = CHO_FONT_ADDR + NUM_CHO_FORM * CHO_COUNT * KOR_GLYPH_SIZE
0063AA  1               JONG_FONT_ADDR = JUNG_FONT_ADDR + NUM_JUNG_FORM * JUNG_COUNT * KOR_GLYPH_SIZE
0063AA  1               
0063AA  1               
0063AA  1               ; variables for korean decomposition in zero-page
0063AA  1               cho	=	x1	; 250d
0063AA  1               jung	=	y1	; 251d
0063AA  1               jong	=	x2	; 252d
0063AA  1               code	=	x2	; 252d; unicode char code(2 bytes);
0063AA  1               
0063AA  1               ; draw ucs2 char with 5x12 font
0063AA  1               ; @param x1(modified)
0063AA  1               ; @param y1(modified)
0063AA  1               ; @param code(modified)
0063AA  1               ; @param color
0063AA  1               ; @returns carry=0 for english, set carry=1 for korean
0063AA  1               .proc dhgr_putc_ucs2
0063AA  1  A5 FD        	lda	code+1
0063AC  1  D0 3A        	bne	@kor	; korean if hi byte is not zero
0063AE  1               
0063AE  1               @eng:
0063AE  1  A5 FC        	lda	code
0063B0  1  38           	sec
0063B1  1  E9 20        	sbc	#ENG_CODE_BEGIN	; A = code - $20
0063B3  1               
0063B3  1  A2 00        	ldx	#0
0063B5  1  86 FF        	stx	ch	; ch=0; temporary use ch as hi byte
0063B7  1  0A           	asl
0063B8  1  26 FF        	rol	ch
0063BA  1  0A           	asl
0063BB  1  26 FF        	rol	ch
0063BD  1  0A           	asl
0063BE  1  26 FF        	rol	ch	; ch:A = A << 3 = (code - $20) * 8
0063C0  1               
0063C0  1  18           	clc
0063C1  1  69 20        	adc	#<ENG_FONT_ADDR
0063C3  1  85 CE        	sta	src
0063C5  1  A5 FF        	lda	ch	; hi-byte
0063C7  1  69 6D        	adc	#>ENG_FONT_ADDR
0063C9  1  85 CF        	sta	src+1	; dst = eng_font_addr + (code - $20) * 8
0063CB  1               
0063CB  1  A5 FA        	lda	x1
0063CD  1  69 04        	adc	#(ENG_FONT_WIDTH-1)
0063CF  1  85 FC        	sta	x2
0063D1  1  A5 FB        	lda	y1
0063D3  1  69 0B        	adc	#(ENG_FONT_HEIGHT-1)
0063D5  1  85 FD        	sta	y2
0063D7  1  A5 FA 48 A5  	PUSH x1,y1
0063DB  1  FB 48        
0063DD  1  20 F5 62     	jsr	dhgr_bitmap	; draw eng font in src to framebuffer x1,y1,x1+5-1,y1+12-1
0063E0  1  68 85 FB 68  	PULL y1,x1
0063E4  1  85 FA        
0063E6  1               
0063E6  1  18           	clc	; carry=0 for english
0063E7  1  60           	rts
0063E8  1               
0063E8  1               @kor:
0063E8  1  A5 FA 48 A5  	PUSH	x1,y1
0063EC  1  FB 48        
0063EE  1               
0063EE  1  A9 5F        	lda	#<kor_buf
0063F0  1  85 EB        	sta	dst
0063F2  1  A9 76        	lda	#>kor_buf
0063F4  1  85 EC        	sta	dst+1	; dst = kor_buf
0063F6  1               
0063F6  1  20 9C 6A     	jsr	decompose_ucs2	; code -> cho,jung,jong
0063F9  1               
0063F9  1               ; get cho font
0063F9  1  A5 FA        	lda	cho
0063FB  1               	; determine cho_form by jung and calculate cho font offset
0063FB  1  A4 FB        	ldy	jung
0063FD  1  BE 47 76     	ldx	cho_form_by_jung,y	; cho_form=0,1,2
006400  1  18           	clc
006401  1  7D 5C 76     	adc	cho_form_offset,x	; cho_form_offset=cho_form*19=0,19,38
006404  1  85 FA        	sta	cho	; cho = cho_form * cho_count + cho
006406  1               
006406  1  A2 00        	ldx	#0
006408  1  86 FF        	stx	ch	; ch=0 for hi-byte
00640A  1  0A           	asl
00640B  1  26 FF        	rol	ch
00640D  1  0A           	asl
00640E  1  26 FF        	rol	ch
006410  1  0A           	asl
006411  1  26 FF        	rol	ch
006413  1  0A           	asl
006414  1  26 FF        	rol	ch
006416  1  38           	sec
006417  1  E5 FA        	sbc	cho
006419  1  85 FA        	sta	cho
00641B  1  A5 FF        	lda	ch
00641D  1  E9 00        	sbc	#0
00641F  1  85 FF        	sta	ch	; ch:cho = (cho_form * cho_count + cho) * 15
006421  1               
006421  1  A5 FA        	lda	cho
006423  1  18           	clc
006424  1  69 20        	adc	#<CHO_FONT_ADDR
006426  1  85 CE        	sta	src
006428  1  A5 FF        	lda	ch	; hi-byte
00642A  1  69 70        	adc	#>CHO_FONT_ADDR
00642C  1  85 CF        	sta	src+1	; src = cho_font_base + (cho_form*cho_count + cho)*15; cho_form=0,1,2
00642E  1               
00642E  1  A0 0E        	ldy	#(KOR_GLYPH_SIZE-1)
006430  1               @loop_cho_font:
006430  1  B1 CE        	lda	(src),y
006432  1  91 EB        	sta	(dst),y
006434  1  88           	dey
006435  1  10 F9        	bpl	@loop_cho_font	; copy cho font in src to kor_buf in dst
006437  1               
006437  1               ; get jung font
006437  1  A5 FB        	lda	jung
006439  1  A2 00        	ldx	#0
00643B  1  86 FF        	stx	ch	; ch=0 for hi-byte
00643D  1  0A           	asl
00643E  1  26 FF        	rol	ch
006440  1  0A           	asl
006441  1  26 FF        	rol	ch
006443  1  0A           	asl
006444  1  26 FF        	rol	ch
006446  1  0A           	asl
006447  1  26 FF        	rol	ch
006449  1  38           	sec
00644A  1  E5 FB        	sbc	jung
00644C  1  85 FB        	sta	jung
00644E  1  A5 FF        	lda	ch
006450  1  E9 00        	sbc	#0
006452  1  85 FF        	sta	ch	; ch:jung = (jung << 4) - jung = jung * 15
006454  1               
006454  1  A5 FB        	lda	jung
006456  1  18           	clc
006457  1  69 77        	adc	#<JUNG_FONT_ADDR
006459  1  85 CE        	sta	src
