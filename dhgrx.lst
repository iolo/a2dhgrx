006033  1               ; switch to double hi-res mixed/page1
006033  1               .proc	dhgr_init
006033  1  8D 50 C0     	sta	$c050 ; graphics
006036  1  8D 53 C0     	sta	$c053 ; mixed
006039  1               	;sta	$c052 ; full
006039  1  8D 54 C0     	sta	$c054 ; page1
00603C  1               	;sta	$c055 ; page2
00603C  1  8D 57 C0     	sta	$c057 ; hires
00603F  1  8D 5E C0     	sta	$c05e ; an3 on
006042  1               
006042  1               	; copy this code(MAIN $6000..$7fff) to AUX to avoid crash while bank switching
006042  1  A9 00 85 3C  	MAIN2AUX $6000, $7fff, $6000
006046  1  A9 60 85 3D  
00604A  1  A9 FF 85 3E  
00605E  1               
00605E  1  60           	rts
00605F  1               .endproc
00605F  1               
00605F  1               ; switch to text page1
00605F  1               .proc	dhgr_exit
00605F  1  8D 51 C0     	sta	$c051 ; text
006062  1  8D 5F C0     	sta	$c05f ; an3 off
006065  1  8D 54 C0     	sta	$c054 ; page1
006068  1  60           	rts
006069  1               .endproc
