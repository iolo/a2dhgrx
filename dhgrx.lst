006327  1  A9 00        	lda	#<font4x6
006329  1  85 CE        	sta	src
00632B  1  A9 6C        	lda	#>font4x6
00632D  1  85 CF        	sta	src+1
00632F  1               
00632F  1  A5 FF        	lda	ch
006331  1  38           	sec
006332  1  E9 20        	sbc	#$20	; A = ch - $20
006334  1  85 FF        	sta	ch
006336  1               
006336  1  A5 CE        	lda	src
006338  1  18           	clc
006339  1  65 FF        	adc	ch
00633B  1  65 FF        	adc	ch
00633D  1  65 FF        	adc	ch
00633F  1  85 CE        	sta	src
006341  1  A5 CF        	lda	src+1
006343  1  69 00        	adc	#$00
006345  1  85 CF        	sta	src+1	; src = font4x6 + (ch - 0x20)*3
006347  1               
006347  1  A5 FA        	lda	x1
006349  1  18           	clc
00634A  1  69 03        	adc	#(FONT_WIDTH-1)
00634C  1  85 FC        	sta	x2
00634E  1               
00634E  1  A5 FB        	lda	y1
006350  1  18           	clc
006351  1  69 05        	adc	#(FONT_HEIGHT-1)
