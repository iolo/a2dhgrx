006000  1               
006000  1               ; shared variables in zero-page
006000  1               ; should be used with PUSH/PULL to avoid conflict with other routines
006000  1               x1	=	$fa	; 250d
006000  1               y1	=	$fb	; 251d
006000  1               x2	=	$fc	; 252d
006000  1               y2	=	$fd	; 253d
006000  1               color	=	$fe	; 254d
006000  1               ch	=	$ff	; 255d
006000  1               src	=	$ce	; 206d; pointer to source address (2 bytes)
006000  1               dst	=	$eb	; 235d; pointer to destination address (2 bytes)
006000  1               
006000  1               ; entry point == jump table
006000  1               .proc	dhgrx
006000  1  4C 2D 60     	jmp	dhgr_init	; $6000(24576)
006003  1  4C 59 60     	jmp	dhgr_exit	; +3
006006  1  4C 63 60     	jmp	dhgr_cls	; +6
006009  1  4C B7 60     	jmp	dhgr_plot	; +9
00600C  1  4C D1 61     	jmp	dhgr_hline	; +12
00600F  1  4C 5C 62     	jmp	dhgr_vline	; +15
