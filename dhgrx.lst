0068C0  2               	.byte 0, 1, 2, 3, 4, 5, 6
0068C0  2               	;.res 256-140
0068C0  2               .endif
0068C0  2               
0068C0  2               ; color 0..15 -> fill bytes 0..3
0068C0  2               ;
0068C0  2               ; to fill 4 bytes(7 consequent color-pixels) with a same color:
0068C0  2               ;
0068C0  2               ; lda color
0068C0  2               ; and #$f
0068C0  2               ; tax
0068C0  2               ;
0068C0  2               ; lda DHGR_FILL_BYTE_0,x
0068C0  2               ; AUX_BANK
0068C0  2               ; sta addr
0068C0  2               ; MAIN_BANK
0068C0  2               ; lda DHGR_FILL_BYTE_1,x
0068C0  2               ; sta addr
0068C0  2               ;
0068C0  2               ; inc addr
0068C0  2               ;
0068C0  2               ; lda DHGR_FILL_BYTE_2,x
0068C0  2               ; AUX_BANK
0068C0  2               ; sta addr
0068C0  2               ; MAIN_BANK
0068C0  2               ; lda DHGR_FILL_BYTE_3,x
0068C0  2               ; sta addr
