00641A  1               
00641A  1               	; first byte: main bank
00641A  1  B1 CE        	lda	(src),y
00641C  1               
00641C  1  5A           	phy
00641D  1  A4 FA        	ldy	x1
00641F  1  91 EB        	sta	(dst),y	; dst[x] = src[y]
006421  1  7A           	ply
006422  1               
