00650B  1  85 FA        	sta	x1
00650D  1  C9 87        	cmp	#(DHGR_WIDTH-5)
00650F  1  90 C4        	bcc	@loop	; if x1 < 140-5
006511  1               
006511  1  A9 00        	lda	#0
006513  1  85 FA        	sta	x1	; x=0 carrage return
