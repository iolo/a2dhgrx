00637F  1  85 CE 68 85  
006383  1  FE 68 85 FB  
00638A  1  C8           	iny		; next char
00638B  1               
00638B  1  A5 FA        	lda	x1
00638D  1  18           	clc
00638E  1  69 04        	adc	#FONT_WIDTH
006390  1  85 FA        	sta	x1
006392  1  A9 8B        	lda	#(DHGR_WIDTH-1)
006394  1  C5 FA        	cmp	x1
006396  1  B0 C9        	bcs	@loop
006398  1  A9 00        	lda	#0
00639A  1  85 FA        	sta	x1	; carrage return
00639C  1  A5 FB        	lda	y1
00639E  1  18           	clc
00639F  1  69 06        	adc	#FONT_HEIGHT
0063A1  1  85 FB        	sta	y1	; line feed
0063A3  1  A9 BF        	lda	#(DHGR_HEIGHT-1)
0063A5  1  C5 FB        	cmp	y1
0063A7  1  B0 B8        	bcs	@loop
0063A9  1               @break:
0063A9  1  60           	rts
0063AA  1               .endproc
