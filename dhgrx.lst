0067C1  2               	MATH_PUSH16 r2, r3, r4, r5, r6, r7
0067C1  2               .endmacro
0067C1  2               
0067C1  2               ; pull(pop) 8bit registers to stack
0067C1  2               ; modified: A
0067C1  2               .macro  MATH_PULL8 r1, r2, r3, r4, r5, r6, r7
0067C1  2               .ifblank	r1
0067C1  2               	.exitmacro
0067C1  2               .else
0067C1  2                 pla
0067C1  2                 sta	r1
0067C1  2               .endif
0067C1  2               	MATH_PULL8 r2, r3, r4, r5, r6, r7
0067C1  2               .endmacro
0067C1  2               
0067C1  2               ; pull(pop) 16bit registers to stack
0067C1  2               ; modified: A
0067C1  2               .macro  MATH_PULL16 r1, r2, r3, r4, r5, r6, r7
0067C1  2               .ifblank	r1
0067C1  2               	.exitmacro
0067C1  2               .else
0067C1  2               	pla
0067C1  2                 sta	r1+1
0067C1  2                 pla
0067C1  2                 sta	r1
0067C1  2               .endif
0067C1  2               	MATH_PULL16 r2, r3, r4, r5, r6, r7
0067C1  2               .endmacro
0067C1  2               
0067C1  2               ; load 8bit register from immediate or absolute
0067C1  2               .macro MATH_LOAD8 reg,arg
0067C1  2                 .if (.match(.left (1, {arg}), #))
0067C1  2                   ; immediate
0067C1  2                   lda #<(.right (.tcount ({arg})-1, {arg})
0067C1  2                   sta reg
0067C1  2                 .else
0067C1  2                   ; absolute
0067C1  2                   lda arg
0067C1  2                   sta reg
0067C1  2                 .endif
0067C1  2               .endmacro
0067C1  2               
0067C1  2               ; load 16bit register from immediate or absolute
0067C1  2               .macro MATH_LOAD16 reg,arg
0067C1  2                 .if (.match(.left (1, {arg}), #))
0067C1  2                   ; immediate
0067C1  2                   lda #<(.right (.tcount ({arg})-1, {arg}))
0067C1  2                   sta reg
0067C1  2                   lda #>(.right (.tcount ({arg})-1, {arg}))
0067C1  2                   sta reg+1
0067C1  2                 .else
0067C1  2                   ; absolute
0067C1  2                   lda arg
0067C1  2                   sta reg
0067C1  2                   lda arg+1
0067C1  2                   sta reg+1
0067C1  2                 .endif
0067C1  2               .endmacro
0067C1  2               
0067C1  2               ; store 8bit register to absolute
0067C1  2               .macro MATH_STORE8 reg,arg
0067C1  2                 lda reg
0067C1  2                 sta arg
0067C1  2               .endmacro
0067C1  2               
0067C1  2               ; store 16bit register to absolute
0067C1  2               .macro MATH_STORE16 reg,arg
0067C1  2                 lda reg
0067C1  2                 sta arg
0067C1  2                 lda reg+1
0067C1  2                 sta arg+1
0067C1  2               .endmacro
0067C1  2               
0067C1  2               ; AX = AX + BX
0067C1  2               .proc MATH_ADD16
0067C1  2  18             clc
0067C2  2  A5 50          lda MATH_AL
0067C4  2  65 54          adc MATH_BL
0067C6  2  85 50          sta MATH_AL
0067C8  2  A5 51          lda MATH_AH
0067CA  2  65 55          adc MATH_BH
0067CC  2  85 51          sta MATH_AH
0067CE  2  60             rts
0067CF  2               .endproc
0067CF  2               
0067CF  2               ; https://codebase64.net/doku.php?id=base:16bit_division_16-bit_result
0067CF  2               ; AX = AX / BX, CX = AX % BX
0067CF  2               .proc MATH_DIV16
0067CF  2               dividend = MATH_AX
0067CF  2               divisor = MATH_BX
0067CF  2               remainder = MATH_CX
0067CF  2               result = dividend ;save memory by reusing divident to store the result
0067CF  2               
0067CF  2               @divide:
0067CF  2  A9 00          lda #0	        ;preset remainder to 0
0067D1  2  85 52        	sta remainder
0067D3  2  85 53        	sta remainder+1
0067D5  2  A2 10        	ldx #16	        ;repeat for each bit: ...
0067D7  2               
0067D7  2               @divloop:
0067D7  2  06 50          asl dividend	;dividend lb & hb*2, msb -> Carry
0067D9  2  26 51        	rol dividend+1
0067DB  2  26 52        	rol remainder	;remainder lb & hb * 2 + msb from carry
0067DD  2  26 53        	rol remainder+1
0067DF  2  A5 52        	lda remainder
0067E1  2  38           	sec
0067E2  2  E5 54        	sbc divisor	;substract divisor to see if it fits in
0067E4  2  A8           	tay	        ;lb result -> Y, for we may need it later
0067E5  2  A5 53        	lda remainder+1
0067E7  2  E5 55        	sbc divisor+1
0067E9  2  90 06        	bcc @skip	;if carry=0 then divisor didn't fit in yet
0067EB  2               
0067EB  2  85 53        	sta remainder+1	;else save substraction result as new remainder,
0067ED  2  84 52        	sty remainder
0067EF  2  E6 50        	inc result	;and INCrement result cause divisor fit in 1 times
0067F1  2               
0067F1  2               @skip:
0067F1  2  CA             dex
0067F2  2  D0 E3        	bne @divloop
0067F4  2  60           	rts
0067F5  2               .endproc
