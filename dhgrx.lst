0069E0  2  00 44 08 4C  	.byte %00000000, %01000100, %00001000, %01001100, %00010001, %01010101, %00011001, %01011101
0069E4  2  11 55 19 5D  
0069E8  2  22 66 2A 6E    .byte %00100010, %01100110, %00101010, %01101110, %00110011, %01110111, %00111011, %01111111
0069EC  2  33 77 3B 7F  
