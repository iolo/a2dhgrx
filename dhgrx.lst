00601E  1  4C D5 63     	jmp	dhgr_puts	; +30
006021  1  4C 49 65     	jmp	dhgr_puts_ucs2	; +33
006024  1  4C 97 65     	jmp	dhgr_puts_utf8	; +36
006027  1  4C 2B 63     	jmp	dhgr_load	; +39
00602A  1  4C 67 63     	jmp	dhgr_save	; +42
00602D  1  00 6D        	.word	font4x6		; +45
00602F  1  20 6E        	.word	font5x12	; +47
006031  1  20 71        	.word	font10x12	; +49
006033  1               .endproc
