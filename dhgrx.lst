006A00  1               ;.include	"pixmap.inc"
006A00  1               ;.include	"bitmap.inc"
006A00  1               .include	"kor.s"
006A00  2               ; convert utf8 string to ucs2 string
006A00  2               ;
006A00  2               ; @param src utf8 string pointer. null terminated. max length = 255 bytes
006A00  2               ; @param dst ucs2 string pointer. null terminated. max length = 255 bytes(127 wchars)
006A00  2               .proc utf8_to_ucs2
006A00  2               byte1 = x1
006A00  2               byte2 = y1
006A00  2               byte3 = x2
006A00  2               byte4 = y2
006A00  2               code = color
006A00  2               
006A00  2  A0 00        	ldy #0	; src index
006A02  2  A2 00        	ldx #0	; dst index
006A04  2               
006A04  2               @loop:
006A04  2  B1 CE        	lda	(src),y		; A = *src
006A06  2  F0 28        	beq	@break
006A08  2               
006A08  2  C9 C0        	cmp	#%11000000
006A0A  2  90 2C        	bcc	@utf8_1byte	; A < 1100000
006A0C  2               
006A0C  2  C9 E0        	cmp	#%11100000
006A0E  2  90 32        	bcc	@utf8_2byte	; A < 11100000
006A10  2               
006A10  2  C9 F0        	cmp	#%11110000
006A12  2  90 50        	bcc	@utf8_3byte	; A < 11110000
006A14  2               
006A14  2               	;;cmp #%11111000
006A14  2               	;;bcc @utf8_4byte	; A < 11111000
006A14  2               
006A14  2               @unsupported:
006A14  2  C8           	iny
006A15  2  A9 3F        	lda	#$3f	; '?'
006A17  2  85 FE        	sta	code
006A19  2  A9 00        	lda	#0
006A1B  2  85 FF        	sta	code+1
006A1D  2               
006A1D  2               @continue:
006A1D  2  5A           	phy		; save y(src index)
006A1E  2  DA 7A        	TXY		; x(dst index) -> y
006A20  2  A5 FE        	lda	code
006A22  2  91 EB        	sta	(dst),y	; *dst++ = code
006A24  2  C8           	iny
006A25  2  A5 FF        	lda	code+1
006A27  2  91 EB        	sta	(dst),y	; *dst++ = code+1
006A29  2  C8           	iny
006A2A  2  5A FA        	TYX		; y -> x(dst index)
006A2C  2  7A           	ply		; restore y(src index)
006A2D  2  4C 04 6A     	jmp	@loop
006A30  2               
006A30  2               @break:
006A30  2  DA 7A        	TXY		; x(dst index) -> y
006A32  2  91 EB        	sta	(dst),y	; *dst++ = 0
006A34  2  C8           	iny
006A35  2  91 EB        	sta	(dst),y	; *dst = 0
006A37  2  60           	rts
006A38  2               
006A38  2               @utf8_1byte:
006A38  2               ; 0xxxxxxx -> 0x00..0x7f
006A38  2               	;;lda	(src),y
006A38  2               	;;and	#%01111111
006A38  2  85 FE        	sta	code
006A3A  2  C8           	iny
006A3B  2               
006A3B  2  A9 00        	lda	#0
006A3D  2  85 FF        	sta	code+1
006A3F  2               
006A3F  2  4C 1D 6A     	jmp	@continue
006A42  2               
006A42  2               @utf8_2byte:
006A42  2               ; 110HHHLL 10LLLLLL -> 0x80..0x07ff (11bits)
006A42  2               	;;lda	(src),y
006A42  2  29 1F        	and	#%00011111
006A44  2  85 FA        	sta	byte1	; byte1 = *src++ & 000HHHLL
006A46  2  C8           	iny
006A47  2               
006A47  2  B1 CE        	lda	(src),y
006A49  2  29 3F        	and	#%00111111
006A4B  2  85 FB        	sta	byte2	; byte2 = *src++ & 00LLLLLL
006A4D  2  C8           	iny
006A4E  2               
006A4E  2  A5 FA        	lda	byte1
006A50  2  0A           	asl
006A51  2  0A           	asl
006A52  2  0A           	asl
006A53  2  0A           	asl
006A54  2  0A           	asl
006A55  2  0A           	asl
006A56  2  05 FB        	ora	byte2
006A58  2  85 FE        	sta	code
006A5A  2               
006A5A  2  A5 FA        	lda	byte1
006A5C  2  4A           	lsr
006A5D  2  4A           	lsr
006A5E  2  4A           	lsr
006A5F  2  85 FF        	sta	code+1
006A61  2               
006A61  2  4C 1D 6A     	jmp	@continue
006A64  2               
006A64  2               @utf8_3byte:
006A64  2               ; 1110xxxx 10xxxxxx 10xxxxxx -> 0x800..0xffff (16bits)
006A64  2               	;;lda	(src),y
006A64  2  29 0F        	and	#%00001111
006A66  2  85 FA        	sta	byte1	; byte1 = *src++ & 0000HHHH
006A68  2  C8           	iny
006A69  2               
006A69  2  B1 CE        	lda	(src),y
006A6B  2  29 3F        	and	#%00111111
006A6D  2  85 FB        	sta	byte2	; byte2 = *src++ & 00HHHHLL
006A6F  2  C8           	iny
006A70  2               
006A70  2  B1 CE        	lda	(src),y
006A72  2  29 3F        	and	#%00111111
006A74  2  85 FC        	sta	byte3	; byte3 = *src++ & 00LLLLLL
006A76  2  C8           	iny
006A77  2               
006A77  2  A5 FB        	lda	byte2
006A79  2  0A           	asl
006A7A  2  0A           	asl
006A7B  2  0A           	asl
006A7C  2  0A           	asl
006A7D  2  0A           	asl
006A7E  2  0A           	asl
006A7F  2  05 FC        	ora	byte3
006A81  2  85 FE        	sta	code
006A83  2               
006A83  2  A5 FA        	lda	byte1
006A85  2  0A           	asl
006A86  2  0A           	asl
006A87  2  0A           	asl
006A88  2  0A           	asl
006A89  2  85 FA        	sta	byte1
006A8B  2  A5 FB        	lda	byte2
006A8D  2  4A           	lsr
006A8E  2  4A           	lsr
006A8F  2  05 FA        	ora	byte1
006A91  2  85 FF        	sta	code+1
006A93  2               
006A93  2  4C 1D 6A     	jmp	@continue
006A96  2               
006A96  2               @utf8_4byte:
006A96  2               ; 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx -> 0x10000..0x10ffff (21bits)
006A96  2  C8           	iny
006A97  2  C8           	iny
006A98  2  C8           	iny
006A99  2  4C 14 6A     	jmp	@unsupported
006A9C  2               .endproc
006A9C  2               
006A9C  2               ; decompose ucs2 into cho, jung, jong
006A9C  2               ; @param code(modified)
006A9C  2               ; @return cho, jung, jong
006A9C  2               .proc decompose_ucs2
006A9C  2               	; ensure (syllable < 0xAC00 || syllable > 0xD7A3)
006A9C  2  A5 FD        	lda	code+1
006A9E  2  C9 AC        	cmp	#>KOR_CODE_BEGIN
006AA0  2  90 68        	bcc	@not_hangul	; error if hi(code) < $AC
006AA2  2  C9 D7        	cmp	#>KOR_CODE_END
006AA4  2  F0 02        	beq	@check_lo
006AA6  2  B0 62        	bcs	@not_hangul	; error if hi(code) >= $D7
006AA8  2               @check_lo:
006AA8  2  A5 FC        	lda	code
006AAA  2  C9 A4        	cmp	#<(KOR_CODE_END+1)
006AAC  2  B0 5C        	bcs	@not_hangul	; error if hi(code) == $D7 and lo(code) >= $A4
006AAE  2               
006AAE  2  A5 FC        	lda	code
006AB0  2  38           	sec
006AB1  2  E9 00        	sbc	#<KOR_CODE_BEGIN
006AB3  2  85 FC        	sta	code
006AB5  2  A5 FD        	lda	code+1
006AB7  2  E9 AC        	sbc	#>KOR_CODE_BEGIN
006AB9  2  85 FD        	sta	code+1		;  code -= 0xAC00;
006ABB  2               
006ABB  2  A5 50 48 A5  	MATH_PUSH16 MATH_AX,MATH_BX,MATH_CX
006ABF  2  51 48 A5 54  
006AC3  2  48 A5 55 48  
006ACD  2               
006ACD  2               	; jong = code % JONG_COUNTT
006ACD  2               	; jung = (code / JONG_COUNT) % JUNG_COUNT
006ACD  2               	; cho = (code / JONG_COUNT) / JUNG_COUNT
006ACD  2               
006ACD  2               	; MATH_AX = code / 28, MATH_CX = code % 28
006ACD  2  A5 FC 85 50  	MATH_LOAD16 MATH_AX,code
006AD1  2  A5 FD 85 51  
006AD5  2  A9 1C 85 54  	MATH_LOAD16 MATH_BX,#JONG_COUNT
006AD9  2  A9 00 85 55  
006ADD  2  20 CF 67     	jsr	MATH_DIV16
006AE0  2  A5 52 85 FC  	MATH_STORE8 MATH_CL,jong
006AE4  2               
006AE4  2               	; MATH_AX = (code / 28) / 21, MATH_CX = (code / 28) % 21
006AE4  2  A9 15 85 54  	MATH_LOAD16 MATH_BX,#JUNG_COUNT
006AE8  2  A9 00 85 55  
006AEC  2  20 CF 67     	jsr	MATH_DIV16
006AEF  2  A5 52 85 FB  	MATH_STORE8 MATH_CL,jung
006AF3  2  A5 50 85 FA  	MATH_STORE8 MATH_AL,cho
006AF7  2               
006AF7  2  68 85 53 68  	MATH_PULL16 MATH_CX,MATH_BX,MATH_AX
006AFB  2  85 52 68 85  
006AFF  2  55 68 85 54  
006B09  2  60           	rts
006B0A  2               
006B0A  2               @not_hangul:
006B0A  2  A9 00        	lda #0
006B0C  2  85 FA        	sta cho
006B0E  2  85 FB        	sta jung
006B10  2  85 FC        	sta jong
006B12  2  60           	rts
006B13  2               .endproc
006B13  2               
006B13  2               ; compose cho, jung, jong into ucs2
006B13  2               ; @param cho
006B13  2               ; @param jung
006B13  2               ; @param jong
006B13  2               ; @returns src
006B13  2               .proc compose_ucs2
006B13  2  A9 12        	lda #(CHO_COUNT-1)
006B15  2  C5 FA        	cmp cho
006B17  2  90 0C        	bcc @error	; 18 < cho
006B19  2  A9 14        	lda #(JUNG_COUNT-1)
006B1B  2  C5 FB        	cmp jung
006B1D  2  90 06        	bcc @error	; 20 < jung
006B1F  2  A9 1B        	lda #(JONG_COUNT-1)
006B21  2  C5 FC        	cmp jong
006B23  2  90 00        	bcc @error	; 27 < jong
006B25  2               @error:
006B25  2  A9 7F        	lda #$7f
006B27  2  85 FC        	sta code
006B29  2  A9 00        	lda #0
006B2B  2  85 FD        	sta code+1
006B2D  2  60           	rts
006B2E  2               
006B2E  2               	; code = cho * 588 + jung * 28 + jong
006B2E  2               
006B2E  2               	; 588 = 512 + 64 + 8 + 4
006B2E  2               	; code += cho << 2; // cho * 4
006B2E  2  A5 FA        	lda cho
006B30  2  0A           	asl
006B31  2  0A           	asl
006B32  2  18           	clc
006B33  2  AA           	tax
006B34  2  65 FC        	adc code
006B36  2  A9 00        	lda #0
006B38  2  65 FD        	adc code+1
006B3A  2               	; code += cho << 3; // cho * 8
006B3A  2  8A           	txa
006B3B  2  0A           	asl
006B3C  2  18           	clc
006B3D  2  AA           	tax
006B3E  2  65 FC        	adc code
006B40  2  A9 00        	lda #0
006B42  2  65 FD        	adc code+1
006B44  2               	; code += cho << 6; // cho * 64
006B44  2  8A           	txa
006B45  2  0A           	asl
006B46  2  0A           	asl
006B47  2  0A           	asl
006B48  2  AA           	tax
006B49  2  18           	clc
006B4A  2  65 FC        	adc code
006B4C  2  A9 00        	lda #0
006B4E  2  65 FD        	adc code+1
006B50  2               	; code += cho << 9; // cho * 512
006B50  2  8A           	txa
006B51  2  0A           	asl
006B52  2  0A           	asl
006B53  2  0A           	asl
006B54  2  18           	clc
006B55  2  65 FC        	adc code
006B57  2  A9 00        	lda #0
006B59  2  65 FD        	adc code+1
006B5B  2               
006B5B  2               	; 28 = 16 + 8 + 4
006B5B  2               	; code += jung << 2; // jung * 4
006B5B  2  A5 FB        	lda jung
006B5D  2  0A           	asl
006B5E  2  0A           	asl
006B5F  2  18           	clc
006B60  2  AA           	tax
006B61  2  65 FC        	adc code
006B63  2  A9 00        	lda #0
006B65  2  65 FD        	adc code+1
006B67  2               	; code += jung << 3; // jung * 8
006B67  2  8A           	txa
006B68  2  0A           	asl
006B69  2  AA           	tax
006B6A  2  18           	clc
006B6B  2  65 FC        	adc code
006B6D  2  A9 00        	lda #0
006B6F  2  65 FD        	adc code+1
006B71  2               	; code += jung << 4; // jung * 16
006B71  2  8A           	txa
006B72  2  0A           	asl
006B73  2  AA           	tax
006B74  2  18           	clc
006B75  2  65 FC        	adc code
006B77  2  A9 00        	lda #0
006B79  2  65 FD        	adc code+1
006B7B  2               
006B7B  2               	; code += jong;
006B7B  2  A5 FC        	lda jong
006B7D  2  18           	clc
006B7E  2  65 FC        	adc code
006B80  2  A9 00        	lda #0
006B82  2  65 FD        	adc code+1
006B84  2               
006B84  2               	; code += 0xAC00
006B84  2               	;lda code
006B84  2               	;clc
006B84  2               	;adc #$00
006B84  2  A5 FD        	lda code+1
006B86  2  69 AC        	adc #$AC
006B88  2  85 FD        	sta code+1
006B8A  2               
006B8A  2  60           	rts
006B8B  2               .endproc
