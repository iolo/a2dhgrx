006379  1  85 CE 68 85  
00637D  1  FE 68 85 FB  
006384  1  C8           	iny		; next char
006385  1               
006385  1  A5 FA        	lda	x1
006387  1  18           	clc
006388  1  69 04        	adc	#FONT_WIDTH
00638A  1  85 FA        	sta	x1
00638C  1  A9 8B        	lda	#(DHGR_WIDTH-1)
00638E  1  C5 FA        	cmp	x1
006390  1  B0 C9        	bcs	@loop
006392  1  A9 00        	lda	#0
006394  1  85 FA        	sta	x1	; carrage return
006396  1  A5 FB        	lda	y1
006398  1  18           	clc
