0063AF  1               .proc dhgr_put8
0063AF  1  A0 00        	ldy	#0	; Y = src offset
0063B1  1  A5 FA        	lda	x1
0063B3  1  4A           	lsr
0063B4  1  85 FA        	sta	x1	; x1 = x1 / 2 = dst offset
0063B6  1  90 21        	bcc	@loopy_even
0063B8  1               
0063B8  1               @loopy_odd:
0063B8  1  A6 FB        	ldx	y1
0063BA  1  A9 00        	lda	#<HGR_BASE
0063BC  1  18           	clc
0063BD  1  7D 00 68     	adc	HGR_OFFSET_LO,x
0063C0  1  85 EB        	sta	dst
0063C2  1  A9 20        	lda	#>HGR_BASE
0063C4  1  7D 00 67     	adc	HGR_OFFSET_HI,x
0063C7  1  85 EC        	sta	dst+1	; dst = HGR_BASE + HGR_OFFSET[y1]
0063C9  1               
0063C9  1  B1 CE        	lda	(src),y
0063CB  1               
0063CB  1  5A           	phy
0063CC  1  A4 FA        	ldy	x1
0063CE  1  91 EB        	sta	(dst),y ; dst[x] = src[y]
0063D0  1  7A           	ply
0063D1  1               
