006000  2               ; modified: A
006000  2               .macro	MAIN2AUX start, end, dest
006000  2               	lda	#<start
006000  2               	sta	$3c
006000  2               	lda	#>start
006000  2               	sta	$3d	; src start
006000  2               	lda	#<end
006000  2               	sta	$3e
006000  2               	lda	#>end
006000  2               	sta	$3f	; src end
006000  2               	lda	#<dest
006000  2               	sta	$42
006000  2               	lda	#>dest
006000  2               	sta	$43	; dest addr
006000  2               	sec		; main to aux
006000  2               	jsr	$c311	; auxmove
006000  2               .endmacro
006000  2               
006000  2               
006000  2               ; modified: A
006000  2               .macro	AUX2MAIN start, end, dest
006000  2               	lda	#<start
006000  2               	sta	$3c
006000  2               	lda	#>start
006000  2               	sta	$3d	; src start
006000  2               	lda	#<end
006000  2               	sta	$3e
006000  2               	lda	#>end
006000  2               	sta	$3f	; src end
006000  2               	lda	#<dest
006000  2               	sta	$42
006000  2               	lda	#>dest
006000  2               	sta	$43	; dest addr
006000  2               	clc		; aux to main
006000  2               	jsr	$c311	; auxmove
006000  2               .endmacro
006000  2               
006000  2               .macro INC16 oper
006000  2                 ;;lda #1
006000  2                 ;;clc
006000  2                 ;;adc oper
006000  2                 ;;sta oper
006000  2                 ;;lda #0
006000  2                 ;;adc oper+1
006000  2                 ;;sta oper+1
006000  2                 .local @no_carry
006000  2                 inc	oper
006000  2               	bne	@no_carry
006000  2                 inc	oper+1
006000  2               @no_carry:
006000  2               .endmacro
