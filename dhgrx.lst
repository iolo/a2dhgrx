006B45  1               
006B45  1               cho_form_by_jung:
006B45  1               	; cho=0..19, jung=0..20 -> cho_form=0,1,2
006B45  1               	;     ㅏ,ㅐ,ㅑ,ㅒ,ㅓ,ㅔ,ㅕ,ㅖ,ㅗ,ㅘ,ㅙ,ㅚ,ㅛ,ㅜ,ㅝ,ㅞ,ㅟ,ㅠ,ㅡ,ㅢ,ㅣ
006B45  1  00 00 00 00  	.byte 0, 0, 0, 0, 0, 0, 0, 0, 1, 2, 2, 2, 1, 1, 2, 2, 2, 1, 1, 2, 0
006B49  1  00 00 00 00  
006B4D  1  01 02 02 02  
006B5A  1               
006B5A  1               cho_form_offset:
006B5A  1               	; cho_font_addr + cho_form * cho_count; cho_form=0,1,2; cho_count=19
006B5A  1  00 13 26     	.byte	0, CHO_COUNT, CHO_COUNT*2
006B5D  1               
006B5D  1               ; kor font buffer
006B5D  1               kor_buf:
006B5D  1  xx xx xx xx  	.res 15
006B61  1  xx xx xx xx  
006B65  1  xx xx xx xx  
006B6C  1               
006B6C  1  xx xx xx xx  .align $100
006B70  1  xx xx xx xx  
006B74  1  xx xx xx xx  
006C00  1               ; utf8_to_ucs2 buffer
006C00  1               ucs2_buf:
006C00  1  xx xx xx xx  	.res 256
006C04  1  xx xx xx xx  
006C08  1  xx xx xx xx  
006D00  1               
006D00  1               .align $100
006D00  1               font4x6:
006D00  1  00 00 00 44  	.incbin "font4x6.bin"
006D04  1  40 40 AA 00  
006D08  1  00 AE AE A0  
006E20  1               
006E20  1               ;//.align $100
006E20  1               font5x12:
006E20  1  00 00 00 00  	.incbin "font5x12.bin"
006E24  1  00 00 00 00  
006E28  1  00 08 42 10  
007120  1               
007120  1               ;//.align $100
007120  1               font10x12:
007120  1  F8 02 00 80  	.incbin "font10x12.bin"
007124  1  20 08 00 00  
