0067E0  2               DHGR_FILL_BYTE_2:
0067E0  2  00 44 08 4C  	.byte %00000000, %01000100, %00001000, %01001100, %00010001, %01010101, %00011001, %01011101
0067E4  2  11 55 19 5D  
