006215  1  BD 00 66     	lda	DIV7_TBL,x
006218  1  0A           	asl
006219  1  A8           	tay	; Y = (x1 / 7) * 2 = byte offset of x1
00621A  1               
00621A  1  A5 FE        	lda	color
00621C  1  29 0F        	and	#%1111
00621E  1  AA           	tax	; X <- color & 0x0f
