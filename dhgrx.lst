0064D3  1               ; draw ucs2 text string
0064D3  1               ;
0064D3  1               ; @param x1(modified)
0064D3  1               ; @param y1(modified)
0064D3  1               ; @param src - pointer to string ends with zero
0064D3  1               ; @param color
0064D3  1               .proc dhgr_puts_ucs2
0064D3  1  A0 00        	ldy	#0 ; src index
0064D5  1               @loop:
0064D5  1  B1 CE        	lda	(src),y ; lo
0064D7  1  85 FC        	sta	code
0064D9  1  C8           	iny		; next byte
0064DA  1  11 CE        	ora	(src),y
0064DC  1  F0 42        	beq	@break	; break if hi=0 and lo=0
0064DE  1  B1 CE        	lda	(src),y ; hi
0064E0  1  85 FD        	sta	code+1
0064E2  1  5A           	phy
0064E3  1  A5 CE 48 A5  	PUSH src,src+1,x1,y1
0064E7  1  CF 48 A5 FA  
0064EB  1  48 A5 FB 48  
0064EF  1  20 AA 63     	jsr	dhgr_putc_ucs2
0064F2  1  68 85 FB 68  	PULL y1,x1,src+1,src
0064F6  1  85 FA 68 85  
0064FA  1  CF 68 85 CE  
0064FE  1  7A           	ply
0064FF  1  C8           	iny		; next ucs2 char
