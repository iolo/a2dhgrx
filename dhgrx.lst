00644B  1               
00644B  1  5A           	phy
00644C  1  A4 FA        	ldy	x1
00644E  1  8D 55 C0     	AUX_BANK
006451  1  91 EB        	sta	(dst),y	; dst[x] = src[y]
006453  1  8D 54 C0     	MAIN_BANK
006456  1  7A           	ply
006457  1               
006457  1               	; second byte: main bank & same address
006457  1  C8           	iny
006458  1  B1 CE        	lda	(src),y
00645A  1               
00645A  1  A4 FA        	ldy	x1
