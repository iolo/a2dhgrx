0062E0  1               
0062E0  1  AE EE 62     	ldx	@_x1
0062E3  1  86 FA        	stx	x1	; reset x1(next row, first column)
0062E5  1  E6 FB        	inc	y1
0062E7  1  A6 FD        	ldx	y2
0062E9  1  E4 FB        	cpx	y1
