0062EF  1               .proc	dhgr_bitmap
0062EF  1  A5 FA        	lda	x1
0062F1  1  8D 26 63     	sta	@_x1
0062F4  1               	;//lda	color
0062F4  1               	;//sta	@_color
0062F4  1               
0062F4  1               @loop:
0062F4  1  A0 00        	ldy	#0
0062F6  1  B1 CE        	lda	(src),y
0062F8  1  A2 08        	ldx	#8	; 8 bits in a byte
0062FA  1               @loop_bit:
0062FA  1  0A           	asl
0062FB  1  90 07        	bcc	@skip	; skip skip transparent
0062FD  1               	;//ldy	@_color
0062FD  1               	;//sty	color
0062FD  1  48           	pha
0062FE  1  DA           	phx
0062FF  1  20 B7 60     	jsr 	dhgr_plot
006302  1  FA           	plx
006303  1  68           	pla
006304  1               @skip:
006304  1  E6 FA        	inc	x1	; next column
006306  1  A4 FC        	ldy	x2
006308  1  C4 FA        	cpy	x1
00630A  1  B0 0E        	bcs	@continue; while x1 <= x2
00630C  1               
00630C  1  AC 26 63     	ldy	@_x1
00630F  1  84 FA        	sty	x1	; carriage return
006311  1  E6 FB        	inc	y1	; line feed
006313  1  A4 FD        	ldy	y2
006315  1  C4 FB        	cpy	y1
006317  1  B0 01        	bcs	@continue; while ++y1 <= y2
006319  1               
006319  1  60           	rts
00631A  1               
00631A  1               @continue:
00631A  1  CA           	dex		; next bit
00631B  1  D0 DD        	bne	@loop_bit
00631D  1  E6 CE        	inc	src	; next byte
00631F  1  D0 D3        	bne	@loop
006321  1  E6 CF        	inc	src+1	; next page
006323  1  D0 CF        	bne	@loop	; jmp always
006325  1  60           	rts		; safe guard
006326  1               
006326  1  00           @_x1:	.byte	0
006327  1               ;//@_color:.byte	0
006327  1               .endproc
