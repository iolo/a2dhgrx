0062EF  1               .proc	dhgr_bitmap
0062EF  1  A5 FA        	lda	x1
0062F1  1  8D 30 63     	sta	@_x1
0062F4  1  A5 FE        	lda	color
0062F6  1  8D 31 63     	sta	@_color
0062F9  1               
0062F9  1               @loop:
0062F9  1  A0 00        	ldy	#0
0062FB  1  B1 CE        	lda	(src),y
0062FD  1  A2 08        	ldx	#8	; 8 bits in a byte
0062FF  1               @loop_bit:
0062FF  1  0A           	asl
006300  1  90 0C        	bcc	@skip	; skip skip transparent
006302  1  AC 31 63     	ldy	@_color
006305  1  84 FE        	sty	color
006307  1  48           	pha
006308  1  DA           	phx
006309  1  20 B7 60     	jsr 	dhgr_plot
00630C  1  FA           	plx
00630D  1  68           	pla
00630E  1               @skip:
00630E  1  E6 FA        	inc	x1	; next column
006310  1  A4 FC        	ldy	x2
006312  1  C4 FA        	cpy	x1
006314  1  B0 0E        	bcs	@continue; while x1 <= x2
006316  1               
006316  1  AC 30 63     	ldy	@_x1
006319  1  84 FA        	sty	x1	; carriage return
00631B  1  E6 FB        	inc	y1	; line feed
00631D  1  A4 FD        	ldy	y2
00631F  1  C4 FB        	cpy	y1
006321  1  B0 01        	bcs	@continue; while ++y1 <= y2
006323  1               
006323  1  60           	rts
006324  1               
006324  1               @continue:
006324  1  CA           	dex		; next bit
006325  1  D0 D8        	bne	@loop_bit
006327  1  E6 CE        	inc	src	; next byte
006329  1  D0 CE        	bne	@loop
00632B  1  E6 CF        	inc	src+1	; next page
00632D  1  D0 CA        	bne	@loop	; jmp always
00632F  1  60           	rts		; safe guard
006330  1               
006330  1  00           @_x1:	.byte	0
006331  1  00           @_color:.byte	0
006332  1               .endproc
