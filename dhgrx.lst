006278  1  A5 FA 48     	PUSH	x1
00627B  1  20 D6 61     	jsr 	dhgr_hline	; hlin x1,x2,y1
00627E  1  68 85 FA     	PULL	x1
006281  1               
006281  1  A5 FA 48 A5  	PUSH	x1, y1
006285  1  FB 48        
006287  1  A5 FD        	lda 	y2
006289  1  85 FB        	sta 	y1
00628B  1  20 D6 61     	jsr 	dhgr_hline	; hlin x1,x2,y2
00628E  1  68 85 FB 68  	PULL	y1, x1
006292  1  85 FA        
006294  1               
006294  1  E6 FB        	inc 	y1
006296  1  C6 FD        	dec 	y2
006298  1               
006298  1  A5 FB 48     	PUSH	y1
00629B  1  20 60 62     	jsr 	dhgr_vline	; vlin y1+1,y2-1,x1
00629E  1  68 85 FB     	PULL	y1
0062A1  1               
