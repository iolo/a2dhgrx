0063D3  1  C8           	iny
0063D4  1  C0 08        	cpy	#8 ; font height
0063D6  1  D0 E0        	bne	@loopy_odd
0063D8  1  60           	rts
0063D9  1               
0063D9  1               @loopy_even:
0063D9  1  A6 FB        	ldx	y1
0063DB  1  A9 00        	lda	#<HGR_BASE
0063DD  1  18           	clc
0063DE  1  7D 00 68     	adc	HGR_OFFSET_LO,x
0063E1  1  85 EB        	sta	dst
0063E3  1  A9 20        	lda	#>HGR_BASE
0063E5  1  7D 00 67     	adc	HGR_OFFSET_HI,x
0063E8  1  85 EC        	sta	dst+1	; dst = HGR_BASE + HGR_OFFSET[y1]
0063EA  1               
0063EA  1  B1 CE        	lda	(src),y
0063EC  1               
0063EC  1  5A           	phy
0063ED  1  A4 FA        	ldy	x1
0063EF  1  8D 55 C0     	AUX_BANK
0063F2  1  91 EB        	sta	(dst),y	; dst[x] = src[y]
0063F4  1  8D 54 C0     	MAIN_BANK
0063F7  1  7A           	ply
0063F8  1               
