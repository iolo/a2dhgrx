0069D0  2  00 22 44 66  	.byte %00000000, %00100010, %01000100, %01100110, %00001000, %00101010, %01001100, %01101110
0069D4  2  08 2A 4C 6E  
0069D8  2  11 33 55 77    .byte %00010001, %00110011, %01010101, %01110111, %00011001, %00111011, %01011101, %01111111
0069DC  2  19 3B 5D 7F  
0069E0  2               
