006226  1  B0 26        	bcs	@loopx_right ; while (x1 + 7 <= x2)
006228  1  85 FA        	sta	x1	; x1 += 7
00622A  1               
00622A  1  BD C0 69     	lda	DHGR_FILL_BYTE_0,x
00622D  1  8D 55 C0     	AUX_BANK
