0062F3  1               
0062F3  1               
0062F3  1               ; draw bitmap
0062F3  1               ;
0062F3  1               ; @param x1(modified)
0062F3  1               ; @param y1(modified)
0062F3  1               ; @param x2
0062F3  1               ; @param y2
0062F3  1               ; @param color
0062F3  1               ; @param src - pointer to pixel data; 1 bit per pixel; (x2-x1+1)*(y2-y1+1) bytes
0062F3  1               .proc	dhgr_bitmap
0062F3  1  A5 FA        	lda	x1
0062F5  1  8D 2A 63     	sta	@_x1
0062F8  1               	;//lda	color
0062F8  1               	;//sta	@_color
0062F8  1               
0062F8  1               @loop:
0062F8  1  A0 00        	ldy	#0
0062FA  1  B1 CE        	lda	(src),y
0062FC  1  A2 08        	ldx	#8	; 8 bits in a byte
0062FE  1               @loop_bit:
0062FE  1  0A           	asl
0062FF  1  90 07        	bcc	@skip	; skip skip transparent
006301  1               	;//ldy	@_color
006301  1               	;//sty	color
006301  1  48           	pha
006302  1  DA           	phx
006303  1  20 BD 60     	jsr 	dhgr_plot
006306  1  FA           	plx
006307  1  68           	pla
006308  1               @skip:
006308  1  E6 FA        	inc	x1	; next column
00630A  1  A4 FC        	ldy	x2
00630C  1  C4 FA        	cpy	x1
00630E  1  B0 0E        	bcs	@continue; while x1 <= x2
006310  1               
006310  1  AC 2A 63     	ldy	@_x1
006313  1  84 FA        	sty	x1	; carriage return
006315  1  E6 FB        	inc	y1	; line feed
006317  1  A4 FD        	ldy	y2
006319  1  C4 FB        	cpy	y1
00631B  1  B0 01        	bcs	@continue; while ++y1 <= y2
00631D  1               
00631D  1  60           	rts
00631E  1               
00631E  1               @continue:
00631E  1  CA           	dex		; next bit
00631F  1               
00631F  1  D0 DD        	bne	@loop_bit
006321  1  E6 CE        	inc	src	; next byte
006323  1  D0 D3        	bne	@loop
006325  1  E6 CF        	inc	src+1	; next page
006327  1  D0 CF        	bne	@loop	; jmp always
006329  1  60           	rts		; safe guard
00632A  1               
00632A  1  00           @_x1:	.byte	0
00632B  1               ;//@_color:.byte	0
00632B  1               .endproc
00632B  1               
00632B  1               ; load byte-aligned rectangular area from src to video memory
00632B  1               ;
00632B  1               ; @param x1 0..39 (40 bytes per row)
00632B  1               ; @param y1 0..191
00632B  1               ; @param x2 0..39
00632B  1               ; @param y2 0..191
00632B  1               ; @param src(modified)
00632B  1               .proc dhgr_load
00632B  1  A6 FB        	ldx	y1	; NOTE: reg. X for y
00632D  1               @loop_y:
00632D  1  A9 00        	lda	#<HGR_BASE
00632F  1  18           	clc
006330  1  7D 00 67     	adc	HGR_OFFSET_LO,x
006333  1  85 EB        	sta	dst
006335  1  A9 20        	lda	#>HGR_BASE
006337  1  7D 00 66     	adc	HGR_OFFSET_HI,x
00633A  1  85 EC        	sta	dst+1	; dst = HGR_BASE + HGR_OFFSET[y]
00633C  1               
00633C  1  A4 FA        	ldy	x1	; NOTE: reg. Y for x(for zeropage indirect addressing)
00633E  1               @loop_x:
00633E  1  B2 CE        	lda	(src)
006340  1  8D 55 C0     	AUX_BANK
006343  1  91 EB        	sta	(dst),y	; aux bank = *src++
006345  1  8D 54 C0     	MAIN_BANK
006348  1  E6 CE D0 02  	INC16	src
00634C  1  E6 CF        
00634E  1               
00634E  1  B2 CE        	lda	(src)
006350  1  91 EB        	sta	(dst),y ; main bank = *src++
006352  1  E6 CE D0 02  	INC16	src
006356  1  E6 CF        
006358  1               
006358  1  C8           	iny
006359  1  C4 FC        	cpy	x2
00635B  1  90 E1        	bcc	@loop_x ; while(x <= x2)
00635D  1  F0 DF        	beq	@loop_x
00635F  1               
00635F  1  E8           	inx
006360  1  E4 FD        	cpx	y2
006362  1  90 C9        	bcc	@loop_y ; while(y <= y2)
006364  1  F0 C7        	beq	@loop_y
006366  1               
006366  1  60           	rts
006367  1               .endproc
006367  1               
006367  1               ; save byte-aligned rectangular area from video memory to dst
006367  1               ;
006367  1               ; @param x1 0..39 (40 bytes per row)
006367  1               ; @param y1 0..191
006367  1               ; @param x2 0..39
006367  1               ; @param y2 0..191
006367  1               ; @param dst
006367  1               .proc dhgr_save
006367  1  A6 FB        	ldx	y1	; NOTE: reg. X for y
006369  1               @loop_y:
006369  1  A9 00        	lda	#<HGR_BASE
00636B  1  18           	clc
00636C  1  7D 00 67     	adc	HGR_OFFSET_LO,x
00636F  1  85 CE        	sta	src
006371  1  A9 20        	lda	#>HGR_BASE
006373  1  7D 00 66     	adc	HGR_OFFSET_HI,x
006376  1  85 CF        	sta	src+1	; src = HGR_BASE + HGR_OFFSET[y]
006378  1               
006378  1  A4 FA        	ldy	x1	; NOTE: reg. Y for x(for zeropage indirect addressing)
00637A  1               @loop_x:
00637A  1  8D 55 C0     	AUX_BANK
00637D  1  B1 CE        	lda	(src),y
00637F  1  8D 54 C0     	MAIN_BANK
006382  1  92 EB        	sta	(dst)	; *dst++ = aux bank
006384  1  E6 EB D0 02  	INC16	dst
006388  1  E6 EC        
00638A  1               
00638A  1  B1 CE        	lda	(src),y
00638C  1  92 EB        	sta	(dst)	; *dst++ = main bank(same address)
00638E  1  E6 EB D0 02  	INC16	dst
006392  1  E6 EC        
006394  1               
006394  1  C8           	iny
006395  1  C4 FC        	cpy	x2
006397  1  90 E1        	bcc	@loop_x ; while(x <= x2)
006399  1  F0 DF        	beq	@loop_x
00639B  1               
00639B  1  E8           	inx
00639C  1  E4 FD        	cpx	y2
00639E  1  90 C9        	bcc	@loop_y ; while(y <= y2)
0063A0  1  F0 C7        	beq	@loop_y
0063A2  1               
0063A2  1  60           	rts
0063A3  1               .endproc
0063A3  1               
0063A3  1               FONT_WIDTH	= 4
0063A3  1               FONT_HEIGHT	= 6
0063A3  1               FONT_CODE_BEGIN = $20
0063A3  1               FONT_CODE_END	= $7F
0063A3  1               FONT_GLYPH_BYTES= 3
0063A3  1               FONT_GLYPH_COUNT= 96
0063A3  1               
0063A3  1               ; draw char with 4x6 font
0063A3  1               ;
0063A3  1               ; @param x1(modified)
0063A3  1               ; @param y1(modified)
0063A3  1               ; @param color
0063A3  1               ; @param ch
0063A3  1               .proc	dhgr_putc
0063A3  1  A9 00        	lda	#<font4x6
0063A5  1  85 CE        	sta	src
0063A7  1  A9 6D        	lda	#>font4x6
0063A9  1  85 CF        	sta	src+1
0063AB  1               
0063AB  1  A5 FF        	lda	ch
0063AD  1  38           	sec
0063AE  1  E9 20        	sbc	#$20	; A = ch - $20
0063B0  1  85 FF        	sta	ch
0063B2  1               
0063B2  1  A5 CE        	lda	src
0063B4  1  18           	clc
0063B5  1  65 FF        	adc	ch
0063B7  1  65 FF        	adc	ch
0063B9  1  65 FF        	adc	ch
0063BB  1  85 CE        	sta	src
0063BD  1  A5 CF        	lda	src+1
0063BF  1  69 00        	adc	#$00
0063C1  1  85 CF        	sta	src+1	; src = font4x6 + (ch - 0x20)*3
0063C3  1               
0063C3  1  A5 FA        	lda	x1
0063C5  1  18           	clc
0063C6  1  69 03        	adc	#(FONT_WIDTH-1)
0063C8  1  85 FC        	sta	x2
0063CA  1               
0063CA  1  A5 FB        	lda	y1
0063CC  1  18           	clc
0063CD  1  69 05        	adc	#(FONT_HEIGHT-1)
0063CF  1  85 FD        	sta	y2
0063D1  1               
0063D1  1  20 F3 62     	jsr	dhgr_bitmap
0063D4  1  60           	rts
0063D5  1               .endproc
0063D5  1               
0063D5  1               
0063D5  1               ; draw text string with 4x6 font
0063D5  1               ;
0063D5  1               ; @param x1(modified)
0063D5  1               ; @param y1(modified)
0063D5  1               ; @param color
0063D5  1               ; @param src - pointer to string ends with zero
0063D5  1               .proc	dhgr_puts
0063D5  1  A0 00        	ldy	#0
0063D7  1               @loop:
0063D7  1  B1 CE        	lda	(src),y
0063D9  1  F0 44        	beq	@break
0063DB  1  85 FF        	sta	ch
0063DD  1  A5 FA 48 A5  	PUSH	x1, y1, color, src, src+1
0063E1  1  FB 48 A5 FE  
0063E5  1  48 A5 CE 48  
0063EC  1  5A           	phy
0063ED  1  20 A3 63     	jsr	dhgr_putc
0063F0  1  7A           	ply
0063F1  1  68 85 CF 68  	PULL	src+1, src, color, y1, x1
0063F5  1  85 CE 68 85  
0063F9  1  FE 68 85 FB  
006400  1  C8           	iny		; next char
006401  1               
006401  1  A5 FA        	lda	x1
006403  1  18           	clc
006404  1  69 04        	adc	#FONT_WIDTH
006406  1  85 FA        	sta	x1
006408  1  A9 8B        	lda	#(DHGR_WIDTH-1)
00640A  1  C5 FA        	cmp	x1
00640C  1  B0 C9        	bcs	@loop
00640E  1  A9 00        	lda	#0
006410  1  85 FA        	sta	x1	; carrage return
006412  1  A5 FB        	lda	y1
006414  1  18           	clc
006415  1  69 06        	adc	#FONT_HEIGHT
006417  1  85 FB        	sta	y1	; line feed
006419  1  A9 BF        	lda	#(DHGR_HEIGHT-1)
00641B  1  C5 FB        	cmp	y1
00641D  1  B0 B8        	bcs	@loop
00641F  1               @break:
00641F  1  60           	rts
006420  1               .endproc
006420  1               
006420  1               
006420  1               ENG_FONT_ADDR = font5x12
006420  1               ENG_FONT_WIDTH = 5
006420  1               ENG_FONT_HEIGHT = 12
006420  1               ENG_CODE_BEGIN = $20
006420  1               ENG_CODE_END = $7f
006420  1               ENG_GLYPH_COUNT = 96	; 0x20 ~ 0x7f
006420  1               ENG_GLYPH_SIZE = 8	; 5x12 = 60bits -> 60/8 <= 8bytes
006420  1               
006420  1               KOR_FONT_WIDTH = 10
006420  1               KOR_FONT_HEIGHT = 12
006420  1               KOR_CODE_BEGIN = $ac00	; 가
006420  1               KOR_CODE_END = $d7a3	; 힣
006420  1               NUM_CHO_FORM = 3	; 0 for vertical-shaped, 1 for horizontal-shaped, 2 for compound
006420  1               NUM_JUNG_FORM = 1
006420  1               NUM_JONG_FORM = 1
006420  1               CHO_COUNT = 19		; ㄱ,ㄲ,ㄴ,ㄷ,ㄸ,ㄹ,ㅁ,ㅂ,ㅃ,ㅅ,ㅆ,ㅇ,ㅈ,ㅉ,ㅊ,ㅋ,ㅌ,ㅍ,ㅎ
006420  1               JUNG_COUNT = 21		; ㅏ,ㅐ,ㅑ,ㅒ,ㅓ,ㅔ,ㅕ,ㅖ,ㅗ,ㅘ,ㅙ,ㅚ,ㅛ,ㅜ,ㅝ,ㅞ,ㅟ,ㅠ,ㅡ,ㅢ,ㅣ
006420  1               JONG_COUNT = 28		; fill,ㄱ,ㄲ,ㄳ,ㄴ,ㄵ,ㄶ,ㄷ,ㄹ,ㄺ,ㄻ,ㄼ,ㄽ,ㄾ,ㄿ,ㅀ,ㅁ,ㅂ,ㅄ,ㅅ,ㅆ,ㅇ,ㅈ,ㅊ,ㅋ,ㅌ,ㅍ,ㅎ
006420  1               KOR_GLYPH_SIZE = 15	; 10x12 = 120bits -> 120/8 = 15bytes
006420  1               KOR_GLYPH_COUNT = NUM_CHO_FORM*CHO_COUNT + NUM_JUNG_FORM*JUNG_COUNT + NUM_JONG_FORM*(JONG_COUNT-1)
006420  1               
006420  1               KOR_FONT_ADDR = font10x12
006420  1               CHO_FONT_ADDR = KOR_FONT_ADDR
006420  1               JUNG_FONT_ADDR = CHO_FONT_ADDR + NUM_CHO_FORM * CHO_COUNT * KOR_GLYPH_SIZE
006420  1               JONG_FONT_ADDR = JUNG_FONT_ADDR + NUM_JUNG_FORM * JUNG_COUNT * KOR_GLYPH_SIZE
006420  1               
006420  1               
006420  1               ; variables for korean decomposition in zero-page
006420  1               cho	=	x1	; 250d
006420  1               jung	=	y1	; 251d
006420  1               jong	=	x2	; 252d
006420  1               code	=	x2	; 252d; unicode char code(2 bytes);
006420  1               
006420  1               ; draw ucs2 char with 5x12 font
006420  1               ; @param x1(modified)
006420  1               ; @param y1(modified)
006420  1               ; @param code(modified)
006420  1               ; @param color
006420  1               ; @returns carry=0 for english, set carry=1 for korean
006420  1               .proc dhgr_putc_ucs2
006420  1  A5 FD        	lda	code+1
006422  1  D0 3A        	bne	@kor	; korean if hi byte is not zero
006424  1               
006424  1               @eng:
006424  1  A5 FC        	lda	code
006426  1  38           	sec
006427  1  E9 20        	sbc	#ENG_CODE_BEGIN	; A = code - $20
006429  1               
006429  1  A2 00        	ldx	#0
00642B  1  86 FF        	stx	ch	; ch=0; temporary use ch as hi byte
00642D  1  0A           	asl
00642E  1  26 FF        	rol	ch
006430  1  0A           	asl
006431  1  26 FF        	rol	ch
006433  1  0A           	asl
006434  1  26 FF        	rol	ch	; ch:A = A << 3 = (code - $20) * 8
006436  1               
006436  1  18           	clc
006437  1  69 20        	adc	#<ENG_FONT_ADDR
