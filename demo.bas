2000 REM INIT
2010 CALL DG
2020 POKE FE,0 : REM COLOR=0
2030 CALL DG+6 : REM CLRSCR
2090 RETURN

2100 REM CLS
2110 FOR C = 0 TO 15
2120 HTAB 1: VTAB 22: PRINT CN$(C);"     "
2130 POKE FE,C
2140 CALL DG+6
2180 NEXT C
2190 RETURN

2200 REM PLOT
2210 FOR I = 0 TO 100
2220 POKE FA, INT(RND(1)*140)
2230 POKE FB, INT(RND(1)*192)
2240 POKE FE, INT(RND(1)*16)
2250 CALL DG+9
2280 NEXT I
2290 RETURN

2300 REM HLINE
2310 X=0:C=1
2320 FOR Y = 0 TO 191
2330 POKE FA,X: POKE FB,Y: POKE FC,139-X
2340 POKE FE,C
2350 CALL DG+12
2360 C=C+1: IF C>15 THEN C=0
2370 X=X+1: IF X>60 THEN X=0
2380 NEXT Y
2390 RETURN

2400 REM VLINE
2410 Y=0:C=1
2420 FOR X = 0 TO 139
2430 POKE FA,X: POKE FB,Y: POKE FD,191-Y
2440 POKE FE,C
2450 CALL DG+15
2460 C=C+1: IF C>15 THEN C=0
2470 Y=Y+1: IF Y>60 THEN Y=0
2480 NEXT X
2490 RETURN

2500 REM RECT
2510 C=0
2520 FOR I = 0 TO 60
2530 POKE FA,I: POKE FB,I: POKE FC,139-I: POKE FD,191-I
2540 POKE FE,C
2550 CALL DG+18
2570 C=C+1: IF C>15 THEN C=1
2580 NEXT I
2590 RETURN

2600 REM FILLRECT
2610 X=0:Y=0:C=0
2620 FOR I = 0 TO 60
2630 POKE FA,X: POKE FB,Y: POKE FC,X+20-1-1: POKE FD,Y+20-1-1
2640 POKE FE,C
2650 CALL DG+21
2660 C=C+1: IF C>15 THEN C=1
2670 X=X+20: IF X>139 THEN X=0: Y=Y+20: IF Y>191 THEN Y=0
2680 NEXT I
2690 RETURN

2700 REM PIXMAP
2710 X=0:Y=0
2720 FOR I = 1 TO 30
2730 POKE FA,X: POKE FB,Y: POKE FC,X+7-1: POKE FD,Y+7-1: POKE CE,0: POKE CF,3: REM $300
2740 CALL DG+24
2770 X=X+10: IF X>139 THEN X=0: Y=Y+10: IF Y>191 THEN Y=0
2780 NEXT I
2790 RETURN

2800 REM BITMAP
2810 X=0:Y=0:C=1
2820 FOR I = 1 TO 30
2830 POKE FA,X: POKE FB,Y: POKE FC,X+8-1: POKE FD,Y+8-1: POKE FE,C
2840 POKE CE,80: POKE CF,3: REM $350, $50=80
2850 CALL DG+27
2860 X=X+10: IF X>139 THEN X=0: Y=Y+10: IF Y>191 THEN Y=0
2870 C=C+1: IF C>15 THEN C=1
2880 NEXT I
2890 RETURN

2900 REM IMAGE
2910 N$="IMAGE1.DHGR"
2920 POKE 49237,0: PRINT CHR$(4);"BLOAD ";N$;",A$2000,L$2000":PRINT
2930 POKE 49236,0: PRINT CHR$(4);"BLOAD ";N$;",A$2000,L$2000,B$2000":PRINT
2990 RETURN

3000 REM PUTC
3010 X=0:Y=0:C=1
3020 FOR I = 32 TO 127
3030 POKE FA,X: POKE FB,Y: POKE FE,C
3040 POKE FF,I
3050 CALL DG+30
3060 X=X+4: IF X>139 THEN X=0: Y=Y+6: IF Y>191 THEN Y=0
3070 C=C+1: IF C>15 THEN C=1
3080 NEXT I
3090 RETURN

3100 REM PUTS
3110 C=1:T$="HELLO,WORLD! 12345677890"
3120 FOR I = 1 TO LEN(T$): POKE 864+I-1,ASC(MID$(T$,I,1)): NEXT I: POKE 864+LEN(T$),0
3130 FOR I = 0 TO 20
3140 POKE FA,I: POKE FB,I*6: POKE FE,C
3150 POKE CE,96: POKE CF,3: REM 864=$360, 96=$60
3160 CALL DG+33
3170 C=C+1: IF C>15 THEN C=1
3180 NEXT I
3190 RETURN

3200 REM PUT8
3210 X=0:Y=0:HI=112:LO=0:REM 7x8FONT SRC=$7000
3220 FOR I = 0 TO 95
3230 POKE FA,X: POKE FB,Y: POKE CE,LO: POKE CF,HI
3240 CALL DG+36
3260 X=X+1: IF X>79 THEN X=0: Y=Y+8: IF Y>191 THEN Y=0
3270 LO=LO+8: IF LO>255 THEN LO=0: HI=HI+1
3280 NEXT I
3290 RETURN

3300 REM PUTC8
3310 X=0:Y=0
3320 FOR I = 32 TO 127
3330 POKE FA,X: POKE FB,Y
3340 POKE FF,I
3350 CALL DG+39
3360 X=X+1: IF X>79 THEN X=0: Y=Y+8: IF Y>191 THEN Y=0
3380 NEXT I
3390 RETURN

3400 REM PUTS8
3410 C=1:T$="HELLO,WORLD! 1234567890"
3420 FOR I = 1 TO LEN(T$): POKE 864+I-1,ASC(MID$(T$,I,1)): NEXT I: POKE 864+LEN(T$),0
3430 FOR I = 0 TO 20
3440 POKE FA,I: POKE FB,I*8
3450 POKE CE,96: POKE CF,3: REM 864=$360, 96=$60
3460 CALL DG+42
3470 C=C+1: IF C>15 THEN C=1
3480 NEXT I
3490 RETURN

