100 PRINT CHR$(4);"PR#3":PRINT
110 PRINT CHR$(4);"BLOAD DHGRX,A$6000":PRINT
1000 DG=24576: REM $6000
1010 FA=250: REM $FA; X1
1020 FB=251: REM $FB; Y1
1030 FC=252: REM $FC; X2
1040 FD=253: REM $FD; Y2
1050 FE=254: REM $FE; COLOR; CO
1060 FF=255: REM $FF; CH
1070 CE=206: REM $CE; SRC LO; SL
1080 CF=207: REM $CF; SRC HI; SH
1090 EB=235: REM $EB; DST LO; DL
1100 EC=236: REM $EC; DST HI; DH

1110 DIM PM%(7*7): FOR I = 1 TO 49: READ PM%(I): NEXT I: REM 7x7 pixmap
1120 DIM BM%(8): FOR I = 1 TO 8: READ BM%(I): NEXT I: REM 8x8 bitmap
1130 DIM CN$(16): FOR C=0 TO 15: READ CN$(C): NEXT C: REM color names
1140 DIM U2%(30): FOR I=1 TO 30: READ U2%(I): NEXT I: REM UCS2 string
1150 DIM U8%(27): FOR I=1 TO 27: READ U8%(I): NEXT I: REM UTF8 string

1500 TEXT:HOME
1510 HTAB 1: VTAB 1: PRINT "DHGRX DEMO"
1520 HTAB 1: VTAB 2: PRINT "1. CLS"
1530 HTAB 1: VTAB 3: PRINT "2. PLOT"
1540 HTAB 1: VTAB 4: PRINT "3. HLINE"
1550 HTAB 1: VTAB 5: PRINT "4. VLINE"
1560 HTAB 1: VTAB 6: PRINT "5. RECT"
1570 HTAB 1: VTAB 7: PRINT "6. FILLRECT"
1580 HTAB 1: VTAB 8: PRINT "7. PIXMAP"
1590 HTAB 1: VTAB 9: PRINT "8. BITMAP"
1610 HTAB 1: VTAB 10: PRINT "9. TEXT"
1620 HTAB 1: VTAB 11: PRINT "A. LOAD/SAVE"
1630 HTAB 1: VTAB 12: PRINT "Q. QUIT"
1640 HTAB 1: VTAB 13: PRINT "SELECT?";:GET A$
1700 IF A$="Q" THEN GOTO 9900
1701 GOSUB 2000
1702 HTAB 1: VTAB 21: CALL-958: REM CEAR_TO_EOS
1710 IF A$="1" THEN PRINT "CLS": GOSUB 2100
1720 IF A$="2" THEN PRINT "PLOT": GOSUB 2200
1730 IF A$="3" THEN PRINT "HLINE": GOSUB 2300
1740 IF A$="4" THEN PRINT "VLINE": GOSUB 2400
1750 IF A$="5" THEN PRINT "RECT": GOSUB 2500
1760 IF A$="6" THEN PRINT "FILLRECT": GOSUB 2600
1770 IF A$="7" THEN PRINT "PIXMAP": GOSUB 2700
1780 IF A$="8" THEN PRINT "BITMAP": GOSUB 2800
1790 IF A$="9" THEN PRINT "TEXT": GOSUB 3000
1800 IF A$="A" THEN PRINT "LOAD/SAVE": GOSUB 3500
1990 HTAB 1: VTAB 22: PRINT "PRESS ANY KEY TO CONTINUE";:GET A$:GOTO 1500

2000 REM INIT
2010 CALL DG
2020 POKE FE,0 : REM COLOR=0
2030 CALL DG+6 : REM CLRSCR
2090 RETURN

2100 REM CLS
2110 FOR C = 0 TO 15
2120 HTAB 1: VTAB 22: PRINT CN$(C);"     "
2130 POKE FE,C
2140 CALL DG+6
2180 NEXT C
2190 RETURN

2200 REM PLOT
2210 FOR I = 0 TO 100
2220 POKE FA, INT(RND(1)*140)
2230 POKE FB, INT(RND(1)*192)
2240 POKE FE, INT(RND(1)*16)
2250 CALL DG+9
2280 NEXT I
2290 RETURN

2300 REM HLINE
2310 X=0:C=1
2320 FOR Y = 0 TO 191
2330 POKE FA,X: POKE FB,Y: POKE FC,139-X
2340 POKE FE,C
2350 CALL DG+12
2360 C=C+1: IF C>15 THEN C=0
2370 X=X+1: IF X>60 THEN X=0
2380 NEXT Y
2390 RETURN

2400 REM VLINE
2410 Y=0:C=1
2420 FOR X = 0 TO 139
2430 POKE FA,X: POKE FB,Y: POKE FD,191-Y
2440 POKE FE,C
2450 CALL DG+15
2460 C=C+1: IF C>15 THEN C=0
2470 Y=Y+1: IF Y>60 THEN Y=0
2480 NEXT X
2490 RETURN

2500 REM RECT
2510 C=0
2520 FOR I = 0 TO 60
2530 POKE FA,I: POKE FB,I: POKE FC,139-I: POKE FD,191-I
2540 POKE FE,C
2550 CALL DG+18
2570 C=C+1: IF C>15 THEN C=1
2580 NEXT I
2590 RETURN

2600 REM FILLRECT
2610 X=0:Y=0:C=0
2620 FOR I = 0 TO 60
2630 POKE FA,X: POKE FB,Y: POKE FC,X+20-1-1: POKE FD,Y+20-1-1
2640 POKE FE,C
2650 CALL DG+21
2660 C=C+1: IF C>15 THEN C=1
2670 X=X+20: IF X>139 THEN X=0: Y=Y+20: IF Y>191 THEN Y=0
2680 NEXT I
2690 RETURN

2700 REM PIXMAP
2701 FOR I = 1 TO 49: POKE 768+I-1,PM%(I): NEXT I: REM $300
2710 X=0:Y=0
2720 FOR I = 1 TO 60
2730 POKE FA,X: POKE FB,Y: POKE FC,X+7-1: POKE FD,Y+7-1: POKE CE,0: POKE CF,3: REM $300
2740 CALL DG+24
2770 X=X+10: IF X>139 THEN X=0: Y=Y+10: IF Y>191 THEN Y=0
2780 NEXT I
2790 RETURN

2800 REM BITMAP
2801 FOR I = 1 TO 8: POKE 768+I-1,BM%(I): NEXT I: BA=768: BS=0: BW=8: BH=8: BN=50: REM 8x8 BITMAP
2802 REM BA=PEEK(DG+39) + PEEK(DG+40)*256: BS=3: BW=4: BH=6: BN=96: REM 4x6 FONT
2803 REM BA=PEEK(DG+41) + PEEK(DG+42)*256: BS=8: BW=5: BH=12: BN=96: REM 5x12 FONT
2804 REM BA=PEEK(DG+43) + PEEK(DG+44)*256: BS=15: BW=10: BH=12: BN=105: REM 10x12 FONT
2810 X=0:Y=0:C=1
2820 FOR I = 1 TO BN
2830 POKE FA,X: POKE FB,Y: POKE FC,X+BW-1: POKE FD,Y+BH-1: POKE FE,C
2840 H=INT(BA/256): POKE CE,BA-(H*256): POKE CF,H: BA=BA+BS: REM NEXT BITMAP
2850 CALL DG+27
2860 X=X+BW: IF X>139 THEN X=0: Y=Y+BH: IF Y>191 THEN Y=0
2870 C=C+1: IF C>15 THEN C=1
2880 NEXT I
2890 RETURN

3000 REM 4x6 FONT
3010 C=1:T$="HELLO,WORLD! 12345677890"
3020 FOR I = 1 TO LEN(T$): POKE 768+I-1,ASC(MID$(T$,I,1)): NEXT I: POKE 768+LEN(T$),0
3030 FOR I = 0 TO 15
3040 POKE FA,I: POKE FB,I*6: POKE FE,C
3050 POKE CE,0: POKE CF,3: REM $300
3060 CALL DG+30
3070 C=C+1: IF C>15 THEN C=1
3080 NEXT I
3100 GET A$:GOSUB 2000: REM 5x12 FONT UCS2
3110 C=1
3120 FOR I = 1 TO 30: POKE 768+I-1,U2%(I): NEXT I
3130 FOR I = 0 TO 15
3140 POKE FA,I: POKE FB,I*12: POKE FE,C
3150 POKE CE,0: POKE CF,3: REM $300
3160 CALL DG+33
3170 C=C+1: IF C>15 THEN C=1
3180 NEXT I
3200 GET A$:GOSUB 2000: REM 5x12 FONT UTF8
3210 C=1
3220 FOR I = 1 TO 27: POKE 768+I-1,U8%(I): NEXT I
3230 FOR I = 0 TO 15
3240 POKE FA,I: POKE FB,I*12: POKE FE,C
3250 POKE CE,0: POKE CF,3: REM $300
3260 CALL DG+36
3270 C=C+1: IF C>15 THEN C=1
3280 NEXT I
3290 RETURN

3500 REM LOAD/SAVE
3510 N$="IMAGE1.DHGR"
3520 POKE 49237,0: PRINT CHR$(4);"BLOAD ";N$;",A$2000,L$2000":PRINT
3530 POKE 49236,0: PRINT CHR$(4);"BLOAD ";N$;",A$2000,L$2000,B$2000":PRINT
3540 FOR I = 1 TO 10
3550 POKE FA,10: POKE FB,30: POKE FC,30: POKE FD,130: POKE EB,0: POKE EC,64: REM $4000
3560 CALL DG+42: REM SAVE
3570 POKE FA,8: POKE FB,35: POKE FC,28: POKE FD,135: POKE CE,0: POKE CF,64: REM $4000
3580 CALL DG+39: REM LOAD
3590 NEXT I
3600 RETURN

9900 REM EXIT
9910 CALL DG+3
9920 HOME: PRINT "THAT'S ALL FOLKS"
9930 END

10000 REM 7X7 PIXMAP
10001 DATA 0, 0, 15, 15, 15, 0, 0
10002 DATA 0, 15, 1, 1, 1, 15, 0
10003 DATA 15, 1, 0, 1, 0, 1, 15
10004 DATA 15, 1, 1, 1, 1, 1, 15
10005 DATA 15, 1, 0, 0, 0, 1, 15
10006 DATA 0, 15, 1, 1, 1, 15, 0
10007 DATA 0, 0, 15, 15, 15, 0, 0

20000 REM 8X8 BITMAP
20001 REM %00111000
20003 REM %01000100
20004 REM %10101010
20005 REM %10000010
20006 REM %10111010
20007 REM	%01000100
20008 REM	%00111000
20009 REM %00000000
20010 DATA 56, 68, 170, 130, 186, 68, 56, 0

30000 REM COLORS
30001 DATA "BLACK", "DKBLUE", "DKGREEN", "BLUE", "BROWN", "LTGRAY", "GREEN", "AQUA"
30002 DATA "RED", "PURPLE", "DKGRAY", "LTBLUE", "ORANGE", "PINK", "YELLOW", "WHITE"

40000 REM UCS2 STRING
40010 DATA 72,0,101,0,108,0,108,0,111,0,44,0,92,213,0,174,33,0,32,0,0,172,152,176,228,178,124,183,0,0

41000 REM UTF8 STRING
41010 DATA 72,101,108,108,111,44,237,149,156,234,184,128,33,32,234,176,128,235,130,152,235,139,164,235,157,188,0
