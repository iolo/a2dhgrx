1110 FOR I = 0 TO 48: READ P: POKE 768+I,P: NEXT I: REM 7x7 pixmap at $300=768
1120 FOR I = 0 TO 7: READ P: POKE 848+I,P: NEXT I: REM 8x8 bitmap at $350=848
1130 DIM CN$(16): FOR C=0 TO 15: READ CN$(C): NEXT C: REM color names

1500 TEXT:HOME
1510 HTAB 1: VTAB 1: PRINT "DHGRX DEMO"
1520 HTAB 1: VTAB 2: PRINT "1. CLS"
1530 HTAB 1: VTAB 3: PRINT "2. PLOT"
1540 HTAB 1: VTAB 4: PRINT "3. HLINE"
1550 HTAB 1: VTAB 5: PRINT "4. VLINE"
1560 HTAB 1: VTAB 6: PRINT "5. RECT"
1570 HTAB 1: VTAB 7: PRINT "6. FILLRECT"
1580 HTAB 1: VTAB 8: PRINT "7. PIXMAP"
1590 HTAB 1: VTAB 9: PRINT "8. BITMAP"
1600 HTAB 1: VTAB 10: PRINT "9. IMAGE"
1610 HTAB 1: VTAB 11: PRINT "A. PUTC"
1620 HTAB 1: VTAB 12: PRINT "B. PUTS"
1630 HTAB 1: VTAB 13: PRINT "Q. QUIT"
1640 HTAB 1: VTAB 14: PRINT "SELECT";:GET A$
1700 IF A$="Q" THEN GOTO 9900
1701 GOSUB 2000
1702 HTAB 1: VTAB 21: CALL-958: REM CEAR_TO_EOS
1710 IF A$="1" THEN PRINT "CLS": GOSUB 2100
1720 IF A$="2" THEN PRINT "PLOT": GOSUB 2200
1730 IF A$="3" THEN PRINT "HLINE": GOSUB 2300
1740 IF A$="4" THEN PRINT "VLINE": GOSUB 2400
1750 IF A$="5" THEN PRINT "RECT": GOSUB 2500
1760 IF A$="6" THEN PRINT "FILLRECT": GOSUB 2600
1770 IF A$="7" THEN PRINT "PIXMAP": GOSUB 2700
1780 IF A$="8" THEN PRINT "BITMAP": GOSUB 2800
1790 IF A$="9" THEN PRINT "BITMAP": GOSUB 2900
1800 IF A$="A" THEN PRINT "PUTC": GOSUB 3000
1810 IF A$="B" THEN PRINT "PUTS": GOSUB 3100
1990 HTAB 1: VTAB 22: PRINT "PRESS ANY KEY TO CONTINUE";:GET A$:GOTO 1500

2000 REM INIT
2010 &GR
2020 &COLOR=0
2030 &HOME
2090 RETURN

2100 REM CLS
2110 FOR C = 0 TO 15
2120 HTAB 1: VTAB 22: PRINT CN$(C);"     "
2130 &COLOR=C
2140 &HOME
2180 NEXT C
2190 RETURN

2200 REM PLOT
2210 FOR I = 0 TO 100
2220 X1=INT(RND(1)*140)
2230 Y1=INT(RND(1)*192)
2240 &COLOR=INT(RND(1)*16)
2250 &PLOT X1,Y1
2280 NEXT I
2290 RETURN

2300 REM HLINE
2310 X=0:C=1
2320 FOR Y = 0 TO 191
2330 X1=X: Y1=Y: X2=139-X
2340 &COLOR=C
2350 &HLIN X1,X2 AT Y1
2360 C=C+1: IF C>15 THEN C=0
2370 X=X+1: IF X>60 THEN X=0
2380 NEXT Y
2390 RETURN

2400 REM VLINE
2410 X=0:C=1
2420 FOR X = 0 TO 139
2430 X1=X: Y1=Y: Y2=191-Y
2440 &COLOR=C
2450 &VLIN Y1,Y2 AT X1
2460 C=C+1: IF C>15 THEN C=0
2470 Y=Y+1: IF Y>60 THEN Y=0
2480 NEXT X
2490 RETURN

2500 REM RECT
2510 C=1
2520 FOR I = 0 TO 60 STEP 5
2530 X1=I: Y1=I: X2=139-I: Y2=191-I
2540 &COLOR=C
2550 &R X1,Y1,X2,Y2
2570 C=C+1: IF C>15 THEN C=1
2580 NEXT I
2590 RETURN

2600 REM FILLRECT
2610 C=1
2620 FOR I = 0 TO 60 STEP 5
2630 X1=I: Y1=I: X2=139-I: Y2=191-I
2640 &COLOR=C
2650 &F X1,Y1,X2,Y2
2670 C=C+1: IF C>15 THEN C=1
2680 NEXT I
2690 RETURN

2700 REM PIXMAP
2710 X=0:Y=0:SR=768: REM $300
2720 FOR I = 1 TO 30
2730 X1=X: Y1=Y: X2=X+7-1: Y2=Y+7-1
2740 &COLOR=0
2750 &XDRAW SR AT X1,Y1,X2,Y2
2760 X=X+10: IF X>130 THEN X=0: Y=Y+10: IF Y>30 THEN Y=0
2780 NEXT I
2790 RETURN

2800 REM BITMAP
2810 X=0:Y=0:C=1:SR=848: REM $350
2820 FOR I = 1 TO 30
2830 X1=X: Y1=Y: X2=X+8-1: Y2=Y+8-1
2840 &COLOR=C
2850 &DRAW SR AT X1,Y1,X2,Y2
2860 X=X+10: IF X>130 THEN X=0: Y=Y+10: IF Y>30 THEN Y=0
2870 C=C+1: IF C>15 THEN C=1
2880 NEXT I
2890 RETURN

2900 REM IMAGE
2910 N$="IMAGE1.DHGR"
2920 POKE 49237,0: PRINT CHR$(4);"BLOAD ";N$;",A$2000,L$2000":PRINT
2930 POKE 49236,0: PRINT CHR$(4);"BLOAD ";N$;",A$2000,L$2000,B$2000":PRINT
2990 RETURN

3000 REM PUTC
3010 X=0:Y=0:C=1
3020 FOR I = 32 TO 127
3030 &HTAB X: &VTAB Y
3040 &COLOR=C
3050 &PRINT I
3060 X=X+4: IF X>130 THEN X=0: Y=Y+6: IF Y>30 THEN Y=0
3070 C=C+1: IF C>15 THEN C=1
3080 NEXT I
3090 RETURN

3100 REM PUTS
3110 &HTAB 5: &VTAB 5: &COLOR=3
3120 &PRINT "HELLO,WORLD!"
3130 &HTAB 5: &VTAB 10: &COLOR=4: L$="": FOR I = 32 TO 127: L$=L$+CHR$(I): NEXT I
3140 &PRINT "**"+L$+"**"
3180 RETURN

9900 REM EXIT
9910 &TEXT
9920 HOME: PRINT "THAT'S ALL FOLKS"
9930 END

